{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lhmax2010/LogAnalysisSkill/patterns/schema.json",
  "title": "gbs pattern library",
  "type": "object",
  "required": [
    "schema_version",
    "tier1_allowed_categories",
    "tier1_forbidden_categories",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "tier1_allowed_categories": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "tier1_forbidden_categories": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "tier",
          "event_kinds",
          "match",
          "confidence",
          "terminal",
          "fix_template"
        ],
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "tier": {"enum": ["tier1"]},
          "event_kinds": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "match": {
            "type": "object",
            "required": ["regex"],
            "properties": {
              "regex": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              },
              "required_context": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "severity": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "tool_in": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "not_in_warning_block": {"type": "boolean"}
                },
                "additionalProperties": false
              },
              "negative_patterns": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "terminal": {"type": "boolean"},
          "fix_template": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
