{
  "data_root": ".runtime/demo-data",
  "cosmos": {
    "archs": [
      "armv7l",
      "x86_64"
    ],
    "regular_archs": [
      "armv7l",
      "x86_64"
    ],
    "report_markers": {
      "report": "GBS Local Full Build Report",
      "summary": "Build Status Summary",
      "expansion": "Expansion error details",
      "export": "Export error details"
    },
    "detail_table_title_prefix": "Build Statis Details",
    "header_must_match": [
      "profile",
      "build_conf",
      "base",
      "product"
    ],
    "status_source": {
      "kind": "detail_page",
      "url_template": "https://example.invalid/build/{build_id}",
      "status_title_regex": "^Build is (.+)$",
      "terminal_words": [
        "successful",
        "failed",
        "cancelled",
        "timed out",
        "timeout"
      ],
      "running_words": [
        "running"
      ],
      "queued_words": [
        "queued",
        "waiting"
      ],
      "header_rule": "unique-build-header-with-own-link"
    },
    "report_root": "https://example.invalid/reports/",
    "report_path_template": "b{last3}/{build_id}/html/Build_Report_{arch}/index.html",
    "bucket_path_template": "b{last3}/",
    "index_link_regex": "^[0-9]+/$",
    "variables_url_template": "https://example.invalid/build/{build_id}/variables",
    "variables_whitelist": [
      "PACKAGE_LIST",
      "SHELVE_LIST",
      "BASE_REPOS",
      "BUILD_CONF",
      "PRODUCT_REPOS"
    ],
    "branch_markers": [
      "[INT]",
      "[FET]",
      "[COSMOS]"
    ]
  },
  "poll": {
    "interval_s": 60,
    "stall_polls": 6,
    "expected_hours": 24,
    "settle_s": 1800,
    "stopped_interval_s": 600,
    "arch_lag_s": 14400,
    "post_terminal_watch_s": 7200,
    "retry_after_event_s": 5
  },
  "export": {
    "chunk_bytes": 55000,
    "allow_types": [
      "report",
      "log",
      "results",
      "summary",
      "verification"
    ]
  },
  "prepush": {
    "words_file": null,
    "credential_patterns": [
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "(?:set-)?cookie\\s*:",
      "jsessionid\\s*=",
      "SAML(?:Request|Response)|Relay(?:State)",
      "wicket\\s*:\\s*interface\\s*=",
      "(?is)<input\\b(?=[^>]*\\btype\\s*=\\s*[\\x22\\x27]?hidden)(?=[^>]*wicket)[^>]*>",
      "(?is)<input\\b(?=[^>]*\\btype\\s*=\\s*[\\x22\\x27]?password)(?=[^>]*\\bvalue\\s*=)[^>]*>",
      "^[^\\s:]+:\\d+=[^:\\s]+:[0-9a-fA-F]{32}\\s*$"
    ]
  },
  "p4": {
    "config_file": "settings/p4.conf",
    "port": "example.invalid:1666",
    "user": "configure-user",
    "expected_server_address": "example.invalid:1666",
    "no_client_name": "vd-cosmos-noclient",
    "unknown_client_marker": "*unknown*",
    "read_config_name": null,
    "tickets_file": "~/.p4tickets",
    "executable": "p4",
    "version": "2026.1",
    "output_protocol": "-G",
    "code0_table": {
      "2026.1": {
        "554768759": {
          "category": "file_missing",
          "severity": 2,
          "exit_code": 0
        },
        "554768749": {
          "category": "history_missing",
          "severity": 2,
          "exit_code": 0
        },
        "822220826": {
          "category": "history_missing",
          "severity": 3,
          "exit_code": 1
        },
        "807672853": {
          "category": "not_logged_in",
          "severity": 3,
          "exit_code": 1
        }
      }
    },
    "min_ticket_minutes": 60,
    "unclassified_retry_limit": 3,
    "timeout_s": 120
  },
  "budget": {
    "disk_warning_bytes": 1073741824
  },
  "network": {
    "proxy": null,
    "no_proxy_hosts": [
      "127.0.0.1",
      "localhost",
      ".example.invalid"
    ],
    "ca_file": null
  },
  "fetch": {
    "timeout_s": 60,
    "max_page_bytes": 20971520,
    "max_log_bytes": 209715200,
    "log_concurrency": 4,
    "user_agent": "VD-Cosmos-LogAnalyzer/0.9.5",
    "deadline_s": 300
  },
  "loop": {
    "max_uncounted_skip_s": 1800
  },
  "snapshot": {
    "merge_tool": "git-merge-file",
    "clock_margin_s": 300,
    "merge_timeout_s": 60
  },
  "analyzer": {
    "snapshot_max_files": 20,
    "snapshot_max_file_bytes": 2097152,
    "snapshot_max_total_bytes": 20971520
  }
}
