+    for cmd in [['git','init','-q','-b','vd-cosmos-loganalyzer'],['git','add','.'],['git','commit','-qm','fixture snapshot']]:
+        subprocess.run(cmd,cwd=destination,env=env,check=True,capture_output=True)
