+    def run(self, replies=None, *, units=None, retrigger=False):
+        self.calls.clear()
+        self.agent_transcript.write_text("")
+        self.script.write_text(
+            json.dumps([{"ok": True}, *(replies if replies is not None else self.replies())])
+        )
+        args = [
+            "qb-trigger",
+            "--state-db",
+            str(self.db.path),
+            "--state-root",
+            str(self.root / "evidence"),
+            "--config",
+            str(self.config),
