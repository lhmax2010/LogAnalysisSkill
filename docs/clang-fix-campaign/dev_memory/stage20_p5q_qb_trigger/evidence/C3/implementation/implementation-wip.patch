+@pytest.mark.parametrize("point", ["intent-mid", "before-submit", "after-submit", "after-bind"])
+def test_crash_windows(c, point):
+    class Crash(BaseException):
+        pass
+
+    if point == "intent-mid":
+        old = state._append_status_on_connection
+
+        def crash(conn, key, status, *args, **kwargs):
+            if status == "QB_REQUESTED":
+                raise Crash()
+            return old(conn, key, status, *args, **kwargs)
+
+        c.monkeypatch.setattr(state, "_append_status_on_connection", crash)
+    elif point == "after-bind":
+        old_bind = trigger._bind
+
+        def crash_bind(*args):
+            old_bind(*args)
+            raise Crash()
+
+        c.monkeypatch.setattr(trigger, "_bind", crash_bind)
+    else:
+        command = trigger.QbBrowser.command
+
+        def crash_command(agent, name, **fields):
+            if name == "submit":
+                if point == "after-submit":
+                    command(agent, name, **fields)
+                raise Crash()
+            return command(agent, name, **fields)
+
+        c.monkeypatch.setattr(trigger.QbBrowser, "command", crash_command)
+    with pytest.raises(Crash):
+        c.run()
+    events = [r["event_type"] for r in c.sql("SELECT * FROM campaign_qb_events")]
+    assert events == (
+        []
+        if point == "intent-mid"
+        else ["SUBMITTED", "BUILD_BOUND"]
+        if point == "after-bind"
+        else ["SUBMITTED"]
+    )
+    assert len(c.sql("SELECT * FROM campaign_qb_profiles")) == (point != "intent-mid")
+
