+@pytest.mark.parametrize("point", ["intent", "not-released", "binding"])
+def test_each_write_transaction_rolls_back(c, point):
+    original = state._append_status_on_connection
+
+    def fail(conn, key, status, *args, **kwargs):
+        if (
+            status
+            == {
+                "intent": "QB_REQUESTED",
+                "not-released": "QB_SUBMIT_FAILED",
+                "binding": "QB_TRIGGERED",
+            }[point]
+        ):
+            raise RuntimeError("injected transaction failure")
+        return original(conn, key, status, *args, **kwargs)
+
+    c.monkeypatch.setattr(state, "_append_status_on_connection", fail)
+    replies = c.replies()
+    if point == "not-released":
+        replies[2] = {"ok": False, "released": False, "error": "QB_FORM_CHANGED"}
+    code, rows = c.run(replies)
+    assert code == 5 and rows[0]["error_code"] == "INTERNAL_ERROR"
+    events = c.sql("SELECT * FROM campaign_qb_events")
+    assert [r["event_type"] for r in events] == ([] if point == "intent" else ["SUBMITTED"])
+    assert len(c.sql("SELECT * FROM campaign_qb_profiles")) == (point != "intent")
