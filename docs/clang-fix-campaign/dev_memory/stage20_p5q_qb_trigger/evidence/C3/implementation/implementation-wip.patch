+def variables(target, marker, changes=None):
+    parser = trigger._VariableRows()
+    parser.feed((ARCHIVE / "02.response.html").read_text())
+    changes = {"BUILD_PKG_LIST_MODIFY": target, "BUILD_NOTES": marker, **(changes or {})}
+    rows = []
+    for row in parser.rows:
+        if len(row) != 3:
+            continue
+        if row[0] in changes:
+            if changes[row[0]] is None:
+                continue
+            row[2] = changes[row[0]]
+        rows.append(
+            "<tr>"
+            + "".join("<td>" + html.escape(value).replace("\n", "<br>") + "</td>" for value in row)
+            + "</tr>"
+        )
+    assert any("BUILD_NOTES" in row for row in rows) or changes.get("BUILD_NOTES") is None
+    return "<table>" + "".join(rows) + "</table>"
