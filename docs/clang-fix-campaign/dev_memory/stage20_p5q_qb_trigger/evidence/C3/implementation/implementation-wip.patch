+    def replies(
+        self, key="u1", request=1, build="100", current="snap-A", option_count=1, read_changes=None
+    ):
+        unit = self.units[key]
+        fields = copy.deepcopy(self.data["qb"]["projects"][unit["branch"]]["form"])
+        fields["SNAPSHOT_NUM"] = current
+        target = key + "@" + unit["derived"]
+        marker = "clang-fix-campaign request=" + uuid.UUID(int=request).hex
+        fields.update({"Build Package List": target, "BUILD NOTES": marker})
+        readback = {
+            f"{name}/{'selection' if name in trigger._PALETTES else 'value'}": value
+            for name, value in fields.items()
+        }
+        return [
+            {"ok": True, "released": False},
+            {
+                "ok": True,
+                "released": False,
+                "readback": readback,
+                "fingerprint": "a" * 64,
+                "snapshot_option_count": option_count,
+            },
+            {"ok": True, "released": True, "landed": "build", "build_id": build},
+            {"ok": True, "status": 200, "html_redacted": variables(target, marker, read_changes)},
+        ]
