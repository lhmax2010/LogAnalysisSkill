  "functions": [
    {
      "reader": "clean_repository_preserving_markers",
      "file": "tizen-ci-shared/scripts/tizen_ci_shared/workspace/__init__.py",
      "qualname": "clean_repository_preserving_markers",
      "lineno": 55,
      "end_lineno": 69,
      "arguments": "worktree_path: Path",
      "source": "def clean_repository_preserving_markers(worktree_path: Path) -> None:\n    \"\"\"Clean the disposable repository while retaining both authority markers.\"\"\"\n\n    _run_git(\n        [\n            \"-C\",\n            str(worktree_path),\n            \"clean\",\n            \"-ffdx\",\n            \"-e\",\n            MARKER_FILENAME,\n            \"-e\",\n            PROTECTED_FILENAME,\n        ]\n    )",
      "references": [
        {
          "kind": "Name",
          "lineno": 67,
          "col_offset": 12,
          "source": "PROTECTED_FILENAME"
        }
      ],
      "context": "."
    },
    {
      "reader": "release_worktree_protection",
      "file": "tizen-ci-shared/scripts/tizen_ci_shared/workspace/__init__.py",
      "qualname": "release_worktree_protection",
      "lineno": 130,
      "end_lineno": 137,
      "arguments": "worktree_path: str",
      "source": "def release_worktree_protection(worktree_path: str) -> bool:\n    \"\"\"Remove a protected-worktree marker when a human confirms it is no longer needed.\"\"\"\n\n    path = Path(worktree_path).resolve() / PROTECTED_FILENAME\n    if not path.exists():\n        return False\n    path.unlink()\n    return True",
      "references": [
        {
          "kind": "Name",
          "lineno": 133,
          "col_offset": 43,
          "source": "PROTECTED_FILENAME"
        }
      ],
      "context": "."
    },
    {
      "reader": "is_protected",
      "file": "tizen-ci-shared/scripts/tizen_ci_shared/workspace/__init__.py",
      "qualname": "is_protected",
      "lineno": 140,
      "end_lineno": 143,
      "arguments": "worktree_path: str | Path",
      "source": "def is_protected(worktree_path: str | Path) -> bool:\n    \"\"\"Return whether a disposable worktree is protected from automatic cleanup.\"\"\"\n\n    return (Path(worktree_path) / PROTECTED_FILENAME).is_file()",
      "references": [
        {
          "kind": "Name",
          "lineno": 143,
          "col_offset": 34,
          "source": "PROTECTED_FILENAME"
        }
      ],
      "context": "."
    },
    {
      "reader": "_exclude_private_files",
      "file": "tizen-ci-shared/scripts/tizen_ci_shared/workspace/__init__.py",
      "qualname": "_exclude_private_files",
      "lineno": 209,
      "end_lineno": 230,
      "arguments": "worktree_path: Path",
      "source": "def _exclude_private_files(worktree_path: Path) -> None:\n    result = subprocess.run(\n        [\"git\", \"-C\", str(worktree_path), \"rev-parse\", \"--git-path\", \"info/exclude\"],\n        check=True,\n        text=True,\n        capture_output=True,\n    )\n    exclude_path = Path(result.stdout.strip())\n    if not exclude_path.is_absolute():\n        exclude_path = worktree_path / exclude_path\n    exclude_path.parent.mkdir(parents=True, exist_ok=True)\n    current = exclude_path.read_text(encoding=\"utf-8\") if exclude_path.exists() else \"\"\n    lines = set(current.splitlines())\n    missing = [\n        filename for filename in (MARKER_FILENAME, PROTECTED_FILENAME) if filename not in lines\n    ]\n    if missing:\n        with exclude_path.open(\"a\", encoding=\"utf-8\") as handle:\n            if current and not current.endswith(\"\\n\"):\n                handle.write(\"\\n\")\n            for filename in missing:\n                handle.write(f\"{filename}\\n\")",
      "references": [
        {
          "kind": "Name",
          "lineno": 223,
          "col_offset": 51,
          "source": "PROTECTED_FILENAME"
        }
      ],
      "context": "."
    }
  ],
