ontext, name in index.by_name if context == 'release-v1.4.0'})\\n    assert names == sorted(duplicates) and len(names) == 85\\n    records = []\\n    for name in names:\\n        pair = []\\n        for ctx, descriptor in (('.', 'pyproject.toml'), ('release-v1.4.0', 'release-v1.4.0/pyproject.toml')):\\n            expected = [row['path'] for row in duplicates[name] if row['config'] == descriptor]\\n            result = index.resolve(ctx, name, 'SCAN-02-regression:' + name)\\n            assert result['kind'] == 'LOCAL'\\n            assert result['targets'] == [{'context': ctx, 'path': expected[0]}] and len(expected) == 1\\n            pair.append(result)\\n            print(f'{name} | {ctx} | {result[\\\"targets\\\"][0][\\\"path\\\"]} | LOCAL')\\n        records.append({'module': name, 'resolutions': pair})\\n    # Re-run the report's real ImportFrom source through the new context index.\\n    example = 'release-v1.4.0/tizen-ci-triage/scripts/ci_triage/gbs_report.py'\\n    imports = [n for n in ast.walk(ast.parse(files[example])) if isinstance(n, ast.ImportFrom) and n.module == 'ci_triage.quickbuild']\\n    assert len(imports) == 1\\n    actual = index.resolve('release-v1.4.0', imports[0].module, f'{example}:{imports[0].lineno}')\\n    assert actual['targets'] == [{'context': 'release-v1.4.0', 'path': 'release-v1.4.0/tizen-ci-triage/scripts/ci_triage/quickbuild.py'}]\\n    scan.write_atomic(out / 'context-regression.json', {\\n        'head': scan.HEAD, 'tree': scan.TREE, 'rules_sha256': scan.RULES_SHA,\\n        'prior_report_sha256': digest(previous.encode()), 'duplicates': records, 'real_import': actual,\\n        'scope': 'ModuleIndex resolution only, not full consumer engine/closure',\\n    })\\n    counts = Counter(e['kind'] for e in index.events)\\n    print(f'DUPLICATES={len(names)} RESOLUTIONS={len(records)*2} REAL_IMPORT=PASS')\\n    print('CONTEXT_COUNTS=' + json.dumps(dict(Counter(e['context'] for e in manifest['entries']))))\\n    print('REGRESSION_FALLBACK_EDGES=' + str(counts['CROSS_CONTEXT_FALLBACK']))\\n    print('REGRESSION_MODULE_IDENTITY_AMBIGUOUS=' + str(counts['MODULE_IDENTITY_AMBIGUOUS']))\\n    print('FULL_CONSUMER_SCAN=NOT_RUN')\\nelif sys.argv[1] == 'scan03':\\n    manifest = json.loads((out / 'manifest-input.json').read_text())\\n    binaries = [entry for entry in manifest['entries'] if entry['entry_kind'] == 'BINARY']\\n    for entry in binaries:\\n        print('ACTUAL_BINARY=' + json.dumps(entry, ensure_ascii=False, sort_keys=True))\\n    print('ACTUAL_BINARY_COUNT=' + str(len(binaries)))\\n    lines = (main / scan.RULES).read_text().splitlines()\\n    start = next(i for i,s in enumerate(lines) if s.startswith('**(三)不覆盖清单'))\\n    end = next(i for i in range(start+1, len(lines)) if lines[i].startswith('**兜底完整性'))\\n    branch_set = set()\\n    for i in range(start,end):\\n        print(f'{scan.RULES}:{i+1}: {lines[i]}')\\n        if lines[i].startswith('|'):\\n            branch_set.update(re.findall(r'`((?:ledger|scan|resolve|provider)\\\\.[^`]+)`', lines[i]))\\n    print('NINE_TABLE_NONCONSUMER_BRANCHES=' + json.dumps(sorted(branch_set)))\\n    for i,s in enumerate(lines):\\n        if (s.startswith('| **12b-3c**') or s.startswith('| **12b-12**') or\\n            'registry 中每个分支' in s or '二进制记录器' in s or '本勘误不新增消费者形态' in s):\\n            print(f'{scan.RULES}:{i+1}: {s}')\\n    print('SCAN-03: E4 requires a BINARY recorder; nine-table owner/branch mapping not specified.')\\n    print('DIAGNOSTIC_ONLY: no invented branch, no four-way verifier PASS/FAIL, no completion marker.')\\nelif sys.argv[1] == 'immutable':\\n    from terminal_predicates import canonical_hash, check_frozen_hashes, load_json\\n    p = load_json(scan.DATA / 'predicates.json')\\n    e = load_json(scan.DATA / 'measurement_exemptions.json')\\n    check_frozen_hashes(p, e)\\n    print('predicates.json canonical=' + canonical_hash(p))\\n    print('measurement_exemptions.json canonical=' + canonical_hash(e))\\n    print('DESIGN_SHA2