+            analyzed = subprocess.run(command, capture_output=True, text=True, check=False)
+            local_path = analyzer / "evidence_packet.json"
+            if analyzed.returncode or not local_path.is_file():
+                raise _StepError(BASELINE_TOOLING_FAILED, "baseline analyzer failed", 5)
