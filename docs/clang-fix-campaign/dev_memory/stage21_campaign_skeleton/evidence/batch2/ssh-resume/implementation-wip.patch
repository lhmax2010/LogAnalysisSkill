+                                          cwd=Path(handle.path)))
+        log = built.analysis_log_path or built.failure_log_path or built.log_path
+        result["build_log"] = str(log)
+        if built.timed_out or built.exit_code == 127:
+            raise _StepError(BASELINE_TOOLING_FAILED, "baseline build tooling failed", 5)
+        synthetic = built.exit_code == 0
+        if synthetic:
+            local_path = options.output_dir / "empty_baseline.json"
+            local_path.write_bytes((json.dumps(EMPTY_BASELINE, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8"))
+        else:
+            analyzer = options.output_dir / "ev_local"
+            command = [sys.executable, "-m", "gbs_analyzer", "analyze", str(log), "--src-root", str(copy),
