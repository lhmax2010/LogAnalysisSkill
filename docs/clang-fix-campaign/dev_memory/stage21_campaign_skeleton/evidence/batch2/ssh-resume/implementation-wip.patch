+        payload["ci_evidence_sha256_used"] = unit.ci_evidence_sha256
+        state.append_event(db, unit.campaign_unit_key, "REPRODUCE", payload)
+        failed = primary and outcome != "matched"
+        state.append_status(db, unit.campaign_unit_key, "NOT_REPRODUCED" if failed else "BASELINE_REPRODUCED", arch_norm=arch)
+        if failed:
+            result["error_code"] = "NOT_REPRODUCED"
+        return 4 if failed else 0, result
