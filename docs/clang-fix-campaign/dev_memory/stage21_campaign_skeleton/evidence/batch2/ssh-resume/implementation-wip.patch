+from __future__ import annotations
+
+import json
+import subprocess
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+import yaml
+from test_campaign_fake_ssh import transport  # noqa: F401
+from tizen_campaign_core._campaign_workspace import _validate_source_identity
+from tizen_campaign_core.campaign_state import get_unit
+from tizen_campaign_intake import intake
+from tizen_ci_shared.state import StateDatabase
+
+
+@pytest.fixture
+def options(tmp_path: Path, transport: tuple[Path, Path, Path]) -> intake.IntakeOptions:  # noqa: F811
+    git = intake.SandboxGit()
+    seed = tmp_path / "seed"
+    git.run(None, "init", str(seed))
+    git.run(seed, "-c", "user.name=Offline Test", "-c", "user.email=test@example.invalid", "commit", "--allow-empty", "-m", "test")
+    commit = git.run(seed, "rev-parse", "HEAD").stdout.strip()
+    git.run(seed, "push", str(transport[1]), "HEAD:refs/heads/master")
+    config = tmp_path / "config.yaml"
+    config.write_text(yaml.safe_dump(dict(campaign_workspace=str(tmp_path / "ws"),
+                                        gerrit_ssh_base="ssh://gerrit.invalid:29418",
+                                        max_rounds=3, max_build_invocations=9)))
+    log = Path(__file__).resolve().parents[1] / "fixtures/e2e_clang_compile/buildlog"
+    return intake.IntakeOptions(tmp_path / "state.db", config, "platform/upstream/example",
+                                "tizen_base", "example", commit, "1", "standard-aarch64", log)
+
+
+def test_intake_fake_ssh_first_clone_and_retry(options: intake.IntakeOptions) -> None:
+    code, payload = intake.campaign_add_unit(options)
+    assert code == 0, payload
+    source = Path(payload["src_clean"])
+    assert intake.SandboxGit().run(source, "remote", "get-url", "origin").stdout.strip() == "ssh://gerrit.invalid:29418/platform/upstream/example"
+    assert set(json.loads((source / ".campaign_clone").read_text())) == {"unit_key", "project", "base_commit"}
+    unit = get_unit(StateDatabase(options.state_db), payload["campaign_unit_key"])
+    assert unit is not None
+    _validate_source_identity(source, unit, subprocess_runner=subprocess.run)
+    second_code, second = intake.campaign_add_unit(options)
+    assert second_code == 0, second
+    assert second == dict(payload, created=False)
+
+
+def test_intake_absolute_local_origin_rejected_before_publish(options: intake.IntakeOptions, transport: tuple[Path, Path, Path]) -> None:  # noqa: F811
+    config = yaml.safe_load(options.config.read_text())
+    config["gerrit_ssh_base"] = str(transport[0])
+    options.config.write_text(yaml.safe_dump(config))
+    code, payload = intake.campaign_add_unit(options)
+    assert code == 4 and payload["error_code"] == "REJECTED_IDENTITY_MISMATCH"
+    root = Path(payload["ci_evidence_ref"]).parent
+    assert not (root / "src").exists()
+    assert not list(root.glob(".src.staging-*"))
+
+
+def test_intake_analyzer_failure_no_unit(options: intake.IntakeOptions, tmp_path: Path) -> None:
+    code, payload = intake.campaign_add_unit(replace(options, ci_log=tmp_path / "missing"))
+    assert code == 5 and payload["error_code"] == "INTAKE_ANALYZER_FAILED"
+    assert not options.state_db.exists()
+
+
+def test_evidence_no_overwrite(tmp_path: Path) -> None:
+    path = tmp_path / "evidence.json"
+    intake.publish_evidence(path, b"first")
+    intake.publish_evidence(path, b"first")
+    with pytest.raises(intake.state.StateInconsistent):
+        intake.publish_evidence(path, b"second")
+    assert path.read_bytes() == b"first"
+
+
+def test_intake_busy_preserves_staging(options: intake.IntakeOptions) -> None:
+    identity = dict(ci_system="quickbuild", source_build_id=options.source_build_id, project=options.project,
+                    branch=options.branch, spec_name=options.spec_name, base_commit=options.base_commit)
+    config = yaml.safe_load(options.config.read_text())
+    root = Path(config["campaign_workspace"]) / intake._unit_hash(intake.build_campaign_unit_key(**identity))
+    with intake.intake_lock(root):
+        staging = root / ".src.staging-other"
+        staging.mkdir()
+        code, payload = intake.campaign_add_unit(options)
+        assert code == 4 and payload["error_code"] == "CAMPAIGN_STATE_BUSY"
+        assert staging.is_dir()
+        assert not options.state_db.exists()
