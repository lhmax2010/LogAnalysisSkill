+"""Locked baseline build, evidence anchoring and reproduction bookkeeping."""
+
+from __future__ import annotations
+
+import fcntl
+import hashlib
+import json
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import yaml
+from gbs_build_skill.runner import BuildOptions, run_gbs_build
+from tizen_build_verify.workspace import create_worktree
+from tizen_campaign_core import campaign_state as state
+from tizen_campaign_core._campaign_workspace import _StepError, _unit_hash, _validate_source_identity
+from tizen_campaign_core.campaign_lifecycle import is_abandoned
+from tizen_campaign_core.reproduce import check
+from tizen_ci_shared.state import StateDatabase
+from tizen_ci_shared.workspace import cleanup_disposable_copy
+from tizen_convergence_judge.convergence import primary_fingerprint
+
+BASELINE_TOOLING_FAILED = "BASELINE_TOOLING_FAILED"
+EMPTY_BASELINE = dict(schema_version="evidence_packet/v1", synthetic=True, reason="baseline_pass", primary_error=None,
+                      error_clusters=dict(schema_version="error_clusters/v1", clusters=[], truncated=False),
+                      cascade_summary="", root_cause_candidates=[])
+
+
+@dataclass(frozen=True)
+class BaselineOptions:
+    campaign_unit_key: str
+    src_clean: Path
+    base_commit: str
+    gbs_conf: Path
+    package: str
+    arch: str
+    profile: str
+    config: Path
+    output_dir: Path
+    state_db: Path
+    evidence_ci: Path | None = None
+    wall_timeout: int = 7200
+    keep_copy: bool = False
+
+
+def _packet(path: Path, digest: str, code: str) -> dict[str, Any]:
+    try:
+        content = path.read_bytes()
+        if hashlib.sha256(content).hexdigest() != digest:
+            raise ValueError("evidence digest mismatch")
+        value = json.loads(content)
+        if not isinstance(value, dict):
+            raise ValueError("evidence must be an object")
+        return value
+    except (OSError, ValueError) as exc:
+        raise _StepError(code, "evidence cannot be validated", 4) from exc
+
+
+def baseline_reproduce(options: BaselineOptions) -> tuple[int, dict[str, Any]]:
+    result: dict[str, Any] = dict(arch_norm=None, outcome=None, is_primary=None, evidence_local=None,
+                                 evidence_sha256=None, synthetic_zero_error=False, gbs_conf_sha256=None,
+                                 build_log=None, basis={}, error_code=None)
+    try:
+        raw = yaml.safe_load(options.config.read_text())
+        if (not isinstance(raw, dict) or not raw.get("campaign_workspace") or not raw.get("clang_conf_path")
+                or options.gbs_conf.resolve() != Path(raw["clang_conf_path"]).expanduser().resolve()
+                or type(options.wall_timeout) is not int or options.wall_timeout <= 0):
+            raise ValueError("invalid baseline configuration")
+        db = StateDatabase(options.state_db)
+        unit = state.get_unit(db, options.campaign_unit_key)
+        if (unit is None or unit.base_commit != options.base_commit or unit.spec_name != options.package
+                or unit.toolchain_profile != options.profile or options.arch not in state.ARCH_RAW_TO_NORM):
+            raise ValueError("invalid baseline identity")
+        arch = state.ARCH_RAW_TO_NORM[options.arch]
+        lock_root = Path(raw["campaign_workspace"]).expanduser().resolve() / _unit_hash(options.campaign_unit_key) / arch
+        lock_root.mkdir(parents=True, exist_ok=True)
+        with (lock_root / ".repair_step.lock").open("a+") as lock:
+            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+            if is_abandoned(db, options.campaign_unit_key):
+                raise _StepError("REJECTED_UNIT_ABANDONED", "unit has been abandoned", 4)
+            return _run_locked(options, db, unit, arch, result)
+    except (BlockingIOError, state.CampaignStateBusy):
+        result["error_code"] = "CAMPAIGN_STATE_BUSY"
+        return 4, result
+    except _StepError as exc:
+        result["error_code"] = exc.code
+        return exc.exit_code, result
+    except state.StateInconsistent:
+        result["error_code"] = "REJECTED_STATE_INCONSISTENT"
+        return 4, result
+    except (ValueError, OSError, yaml.YAMLError):
+        result["error_code"] = "INVALID_ARGS"
+        return 2, result
+
+
+def _run_locked(options: BaselineOptions, db: StateDatabase, unit: state.Unit, arch: str, result: dict[str, Any]) -> tuple[int, dict[str, Any]]:
+    _validate_source_identity(options.src_clean, unit, subprocess_runner=subprocess.run)
+    if unit.ci_evidence_ref is None or unit.ci_evidence_sha256 is None or unit.primary_arch is None:
+        raise _StepError("REJECTED_CI_EVIDENCE_MISMATCH", "unit has no CI anchor", 4)
+    anchor = Path(unit.ci_evidence_ref)
+    if options.evidence_ci is not None and options.evidence_ci.resolve() != anchor.resolve():
