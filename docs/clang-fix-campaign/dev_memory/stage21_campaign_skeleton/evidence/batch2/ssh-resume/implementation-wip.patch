+"""Locked campaign intake with immutable evidence and staged source publication."""
+
+from __future__ import annotations
+
+import fcntl
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterator
+
+import yaml
+from tizen_campaign_core import campaign_state as state
+from tizen_campaign_core._campaign_workspace import (
+    _normalize_project,
+    _StepError,
+    _unit_hash,
+    _validate_source_identity,
+)
+from tizen_campaign_core._sandbox_git import SandboxGit
+from tizen_campaign_core.submission_identity import (
+    build_campaign_unit_key,
+    build_submission_identity_key,
+)
+from tizen_ci_shared.state import StateDatabase
+
+INTAKE_ANALYZER_FAILED = "INTAKE_ANALYZER_FAILED"
+INTAKE_CLONE_FAILED = "INTAKE_CLONE_FAILED"
+
+
+@dataclass(frozen=True)
+class IntakeOptions:
+    state_db: Path
+    config: Path
+    project: str
+    branch: str
+    spec_name: str
+    base_commit: str
+    source_build_id: str
+    failed_arches: str
+    ci_log: Path
+    toolchain_profile: str = "clang"
+
+
+@contextmanager
+def intake_lock(root: Path) -> Iterator[None]:
+    root.mkdir(parents=True, exist_ok=True)
+    with (root / ".intake.lock").open("a+") as stream:
+        try:
+            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise state.CampaignStateBusy("CAMPAIGN_STATE_BUSY") from exc
+        try:
+            yield
+        finally:
+            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
+
+
+def fsync_parent(path: Path) -> None:
+    descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def publish_evidence(path: Path, content: bytes) -> None:
+    temporary: Path | None = None
+    try:
+        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
+            temporary = Path(stream.name)
+            stream.write(content)
+            stream.flush()
+            os.fsync(stream.fileno())
+        try:
+            os.link(temporary, path)
+        except FileExistsError:
+            if path.read_bytes() != content:
+                raise state.StateInconsistent("CI evidence differs from published bytes")
+        except OSError as exc:
+            raise _StepError("WORKSPACE_FS_UNSUPPORTED", "evidence hard-link failed", 5) from exc
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+    fsync_parent(path)
+
+
+def analyze_log(log: Path, directory: Path, package: str) -> bytes:
+    result = subprocess.run(
+        [sys.executable, "-m", "gbs_analyzer", "analyze", str(log),
+         "--output-dir", str(directory), "--output-format", "both", "--package", package],
+        capture_output=True, text=True, check=False,
+    )
+    path = directory / "evidence_packet.json"
+    if result.returncode or not path.is_file():
+        raise _StepError(INTAKE_ANALYZER_FAILED, "analyzer failed or produced no evidence", 5)
+    return path.read_bytes()
+
+
+def prepare_source(root: Path, unit: state.Unit, remote_base: str, git: SandboxGit) -> Path:
+    for leftover in root.glob(".src.staging-*"):
+        if leftover.is_symlink() or not leftover.is_dir():
+            leftover.unlink()
+        else:
+            shutil.rmtree(leftover)
+    canonical = root / "src"
+    if canonical.exists() or canonical.is_symlink():
+        _validate_source_identity(canonical, unit, subprocess_runner=subprocess.run)
+        return canonical
+    staging = Path(tempfile.mkdtemp(prefix=".src.staging-", dir=root))
+    try:
+        git.run(None, "clone", "--", remote_base.rstrip("/") + "/" + unit.project, str(staging), remote=True)
+        git.run(staging, "checkout", "--detach", unit.base_commit)
+        head = git.run(staging, "rev-parse", "HEAD").stdout.strip()
+        origin = git.run(staging, "remote", "get-url", "origin").stdout.strip()
+        if head != unit.base_commit or _normalize_project(origin) != unit.project:
+            raise _StepError("REJECTED_IDENTITY_MISMATCH", "source HEAD or origin does not match campaign unit", 4)
+        marker = dict(unit_key=unit.campaign_unit_key, project=unit.project, base_commit=unit.base_commit)
+        with (staging / ".campaign_clone").open("w", encoding="utf-8") as stream:
+            json.dump(marker, stream, sort_keys=True)
+            stream.flush()
+            os.fsync(stream.fileno())
+        fsync_parent(staging / ".campaign_clone")
+        if canonical.exists() or canonical.is_symlink():
+            raise _StepError("REJECTED_IDENTITY_MISMATCH", "canonical source appeared during intake", 4)
+        os.rename(staging, canonical)
+        fsync_parent(canonical)
+        return canonical
+    except _StepError:
+        raise
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise _StepError(INTAKE_CLONE_FAILED, "source preparation failed", 5) from exc
+    finally:
+        if staging.exists():
+            shutil.rmtree(staging)
+
+
+def campaign_add_unit(options: IntakeOptions) -> tuple[int, dict[str, Any]]:
+    payload: dict[str, Any] = dict(campaign_unit_key=None, primary_arch=None, failed_arches=[],
+                                 ci_evidence_ref=None, ci_evidence_sha256=None, src_clean=None,
+                                 created=False, error_code=None)
+    try:
+        config = yaml.safe_load(options.config.read_text(encoding="utf-8"))
+        if not isinstance(config, dict):
+            raise ValueError("config must be a mapping")
+        for name in ("campaign_workspace", "gerrit_ssh_base"):
+            if not isinstance(config.get(name), str) or not config[name].strip():
+                raise ValueError("missing config field")
+        for name in ("max_rounds", "max_build_invocations"):
+            if type(config.get(name)) is not int or config[name] < 1:
+                raise ValueError("invalid campaign budget")
+        if not (config["gerrit_ssh_base"].startswith("ssh://") or Path(config["gerrit_ssh_base"]).is_absolute()):
+            raise ValueError("invalid remote base")
+        if (not re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", options.project)
+                or any(part in {".", ".."} for part in options.project.split("/"))
+                or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", options.base_commit)
+                or not options.branch.strip() or not options.spec_name.strip()
+                or not options.source_build_id.isdecimal() or int(options.source_build_id) < 1
+                or not options.toolchain_profile.strip()):
+            raise ValueError("invalid campaign identity")
+        arches = tuple(sorted(set(part.strip() for part in options.failed_arches.split(","))))
+        if not all(arches):
+            raise ValueError("failed arches must be non-empty")
+        identity = dict(ci_system="quickbuild", source_build_id=options.source_build_id,
+                        project=options.project, branch=options.branch,
+                        spec_name=options.spec_name, base_commit=options.base_commit)
+        key = build_campaign_unit_key(**identity)
+        submission = build_submission_identity_key(**{k: v for k, v in identity.items() if k != "source_build_id"})
+        root = Path(config["campaign_workspace"]).expanduser().resolve() / _unit_hash(key)
+        payload.update(campaign_unit_key=key, failed_arches=list(arches))
+        db = StateDatabase(options.state_db)
+        with intake_lock(root):
+            shared = dict(campaign_unit_key=key, submission_identity_key=submission,
+                          failed_arches=arches, toolchain_profile=options.toolchain_profile,
+                          max_rounds=config["max_rounds"], max_build_invocations=config["max_build_invocations"],
+                          **identity)
+            if any(arch not in state.ARCH_RAW_TO_NORM for arch in arches):
+                state.create_arch_rejected_unit(db, reason="arch_not_allowed", **shared)
+                payload["error_code"] = "REJECTED_ARCH_NOT_ALLOWED"
+                return 4, payload
+            primary = next(arch for arch in ("standard-aarch64", "standard-armv7l", "standard-x86_64") if arch in arches)
+            with tempfile.TemporaryDirectory(prefix=".ci.staging-", dir=root) as directory:
+                content = analyze_log(options.ci_log, Path(directory), options.spec_name)
+            evidence = root / "ci_evidence.json"
+            publish_evidence(evidence, content)
+            digest = hashlib.sha256(content).hexdigest()
+            payload.update(primary_arch=primary, ci_evidence_ref=str(evidence), ci_evidence_sha256=digest)
+            existing = state.get_unit(db, key)
+            state.create_unit(db, primary_arch=primary, ci_evidence_ref=str(evidence), ci_evidence_sha256=digest, **shared)
+            payload["created"] = existing is None
+            if state.latest_status(db, key) is None:
+                state.append_status(db, key, "DISCOVERED")
+            if state.latest_status(db, key) == "DISCOVERED":
+                state.append_status(db, key, "CI_EVIDENCE_READY")
+            unit = state.get_unit(db, key)
+            assert unit is not None
+            payload["src_clean"] = str(prepare_source(root, unit, config["gerrit_ssh_base"], SandboxGit()))
+        return 0, payload
+    except state.CampaignStateBusy:
+        payload["error_code"] = "CAMPAIGN_STATE_BUSY"
+        return 4, payload
+    except state.StateInconsistent:
+        payload["error_code"] = "REJECTED_STATE_INCONSISTENT"
+        return 4, payload
+    except _StepError as exc:
+        payload["error_code"] = exc.code
+        return exc.exit_code, payload
+    except (ValueError, OSError, yaml.YAMLError):
+        payload["error_code"] = "INVALID_ARGS"
+        return 2, payload
