+"""Campaign release commands and a read-only unit report."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+import yaml
+from tizen_campaign_core import campaign_lifecycle as lifecycle
+from tizen_campaign_core import campaign_state as state
+from tizen_campaign_core._campaign_workspace import _unit_hash
+from tizen_ci_shared.state import StateDatabase
+from tizen_ci_shared.workspace import is_protected
+from tizen_sandbox_submit.sandbox_submit import _locks
+
+
+def finish_unit(db: StateDatabase, key: str) -> tuple[int, dict[str, Any]]:
+    result: dict[str, Any] = dict(campaign_unit_key=key, released=[], retained=False, reason=None, message=None, error_code=None)
+    status = state.latest_status(db, key)
+    if status in lifecycle.TERMINAL_RELEASE:
+        result["released"] = lifecycle.release_terminal_worktrees(db, key)
+    elif status in lifecycle.EMPTY_TERMINAL:
+        pass
+    elif status in lifecycle.HELD:
+        result.update(retained=True, reason=status)
+    else:
+        result.update(error_code=lifecycle.REJECTED_UNIT_NOT_TERMINAL,
+                      message="如决定放弃该 unit,用 campaign-release-worktrees --abandon")
+        return 4, result
+    return 0, result
+
+
+def release_worktrees(db: StateDatabase, key: str, config: Path, *, confirmed_by: str, abandon: bool) -> list[str]:
+    if not confirmed_by.strip():
+        raise lifecycle.ReleaseNotAllowed("confirmation must be non-empty")
+    if not abandon:
+        return lifecycle.release_held_worktrees(db, key, confirmed_by=confirmed_by)
+    raw = yaml.safe_load(config.read_text(encoding="utf-8"))
+    if not isinstance(raw, dict) or not isinstance(raw.get("campaign_workspace"), str) or not raw["campaign_workspace"]:
+        raise ValueError("missing campaign_workspace")
+    root = Path(raw["campaign_workspace"]).expanduser().resolve() / _unit_hash(key)
+    with _locks(root):
+        status = state.latest_status(db, key)
+        abandoned = lifecycle.is_abandoned(db, key)
+        if status is None or (status in lifecycle.TERMINAL and not abandoned):
+            raise lifecycle.ReleaseNotAllowed("unit is terminal")
+        if not abandoned:
+            state.append_event(db, key, "WORKSPACE_RELEASE", dict(paths=[], reason="abandoned", confirmed_by=confirmed_by))
+        return lifecycle.release_abandoned_worktrees(db, key, confirmed_by=confirmed_by)
+
+
+def campaign_report(db: StateDatabase) -> list[dict[str, Any]]:
+    conn = state._read_connection(db)
+    try:
+        units = conn.execute("SELECT * FROM campaign_units ORDER BY created_at, campaign_unit_key").fetchall()
+        rows = []
+        for unit in units:
+            key = str(unit["campaign_unit_key"])
+            status = conn.execute("SELECT status, reason FROM campaign_status_log WHERE campaign_unit_key=? ORDER BY log_id DESC LIMIT 1", (key,)).fetchone()
+            current = str(status["status"]) if status else None
+            reason = status["reason"] if status else None
+            abandoned = lifecycle.is_abandoned(db, key)
+            protected = any(is_protected(path) for path in lifecycle.registered_worktrees(db, key))
+            workspace = "已放弃" if abandoned else "保留待查" if current in lifecycle.HELD else "在用" if protected else "已释放"
+            if abandoned:
+                reason = "abandoned(状态列为放弃时及之后的状态)"
+            review = state.latest_event(db, key, "REVIEW")
+            qb = conn.execute(
+                "SELECT e.* FROM campaign_qb_events e WHERE e.request_seq=(SELECT max(request_seq) FROM campaign_qb_requests WHERE campaign_unit_key=?) ORDER BY e.event_id DESC LIMIT 1", (key,),
+            ).fetchone()
+            child = None
+            if qb and qb["qb_result_ref"]:
+                try:
+                    child = json.loads(Path(qb["qb_result_ref"]).read_text())["child_build_id"]
+                except (OSError, KeyError, ValueError, TypeError):
+                    pass
+            rows.append(dict(campaign_unit_key=key, spec_name=unit["spec_name"], project=unit["project"],
+                             status=current, reason=reason, rounds=conn.execute("SELECT count(*) FROM campaign_rounds WHERE campaign_unit_key=?", (key,)).fetchone()[0],
+                             invocations_used=state.invocations_used(db, key), qb_build_id=qb["qb_build_id"] if qb else None,
+                             child_build_id=child, review_url=review["payload"].get("review_url") if review else None,
+                             worktree_status=workspace))
+        return rows
+    finally:
+        conn.close()
+
+
+def markdown(rows: list[dict[str, Any]]) -> str:
+    keys = ("spec_name", "project", "status", "reason", "rounds", "invocations_used", "qb_build_id", "child_build_id", "review_url", "worktree_status")
+    headings = ("包名", "项目", "最新状态", "终止原因", "修复轮数", "已用编译次数", "QuickBuild父构建", "QuickBuild子构建", "review URL", "副本状态")
+    def cell(value: Any) -> str:
+        return ("" if value is None else str(value)).replace("|", "\\|").replace("\n", "<br>")
+    return "\n".join(["| " + " | ".join(headings) + " |", "| " + " | ".join("---" for _ in keys) + " |"] + ["| " + " | ".join(cell(row[key]) for key in keys) + " |" for row in rows]) + "\n"
