+"""Baseline reproduction identity, independent of error-count drift."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from tizen_convergence_judge.convergence import error_count, primary_fingerprint
+
+
+@dataclass(frozen=True)
+class ReproduceResult:
+    reproduced: bool
+    basis: dict[str, Any]
+
+
+def check(evidence_ci: dict[str, Any], evidence_local: dict[str, Any], *, package: str,
+          arch_norm: str, toolchain_profile: str) -> ReproduceResult:
+    ci = primary_fingerprint(evidence_ci)
+    local = primary_fingerprint(evidence_local)
+    ci_count, local_count = error_count(evidence_ci), error_count(evidence_local)
+    fields = dict(package=package, arch=arch_norm, toolchain_profile=toolchain_profile,
+                  failed_phase=evidence_ci.get("failed_phase"))
+    matched = bool(package and arch_norm and toolchain_profile and ci is not None and local is not None
+                   and ci.identity == local.identity
+                   and evidence_ci.get("failed_phase") == evidence_local.get("failed_phase"))
+    if ci is not None:
+        fields.update(normalized_file=ci.normalized_file, diagnostic_code=ci.diagnostic_code, anchor=ci.anchor)
+    return ReproduceResult(matched, dict(matched_fields=fields if matched else {},
+                                        ci_fp=ci.to_dict() if ci else None, local_fp=local.to_dict() if local else None,
+                                        error_count_ci=ci_count, error_count_local=local_count,
+                                        error_count_drift=ci_count != local_count))
