+"""Release registered campaign copies without deleting their contents."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from tizen_ci_shared.state import StateDatabase
+from tizen_ci_shared.workspace import is_protected, release_worktree_protection
+
+from tizen_campaign_core import campaign_state as state
+
+REJECTED_UNIT_ABANDONED = "REJECTED_UNIT_ABANDONED"
+REJECTED_UNIT_NOT_TERMINAL = "REJECTED_UNIT_NOT_TERMINAL"
+TERMINAL_RELEASE = frozenset({"REVIEW_PUSHED", "REVIEW_INELIGIBLE", "DENIED", "STALLED", "REGRESSED", "ROUNDS_EXHAUSTED"})
+EMPTY_TERMINAL = frozenset({"NOT_REPRODUCED", "REJECTED_ARCH_NOT_ALLOWED"})
+HELD = frozenset({"HELD_FOR_INVESTIGATION", "WORKTREE_LOST", "SANDBOX_QB_FAILED"})
+TERMINAL = TERMINAL_RELEASE | EMPTY_TERMINAL | HELD | {"REVIEW_MANUAL"}
+
+
+class ReleaseNotAllowed(RuntimeError):
+    pass
+
+
+def is_abandoned(state_db: StateDatabase, campaign_unit_key: str) -> bool:
+    conn = state._read_connection(state_db)
+    try:
+        return any(
+            json.loads(row[0]).get("reason") == "abandoned"
+            for row in conn.execute(
+                "SELECT payload_json FROM campaign_gate_events WHERE campaign_unit_key=? AND event_type='WORKSPACE_RELEASE'",
+                (campaign_unit_key,),
+            )
+        )
+    finally:
+        conn.close()
+
+
+def registered_worktrees(state_db: StateDatabase, campaign_unit_key: str) -> list[str]:
+    conn = state._read_connection(state_db)
+    try:
+        state._require_unit(conn, campaign_unit_key)
+        paths = {str(row[0]) for row in conn.execute(
+            "SELECT vr.worktree_path FROM campaign_verifications cv JOIN verification_records vr "
+            "ON vr.verification_id=cv.verification_id WHERE cv.campaign_unit_key=?", (campaign_unit_key,),
+        )}
+        for row in conn.execute(
+            "SELECT payload_json FROM campaign_gate_events WHERE campaign_unit_key=? AND event_type='ORPHAN_PASS'", (campaign_unit_key,),
+        ):
+            paths.add(str(json.loads(row[0])["worktree_path"]))
+        return sorted(paths)
+    finally:
+        conn.close()
+
+
+def _released_paths(state_db: StateDatabase, key: str, reason: str) -> set[str]:
+    conn = state._read_connection(state_db)
+    try:
+        paths: set[str] = set()
+        for row in conn.execute(
+            "SELECT payload_json FROM campaign_gate_events WHERE campaign_unit_key=? AND event_type='WORKSPACE_RELEASE'", (key,),
+        ):
+            payload = json.loads(row[0])
+            if payload["reason"] == reason:
+                paths.update(payload["paths"])
+        return paths
+    finally:
+        conn.close()
+
+
+def _release(db: StateDatabase, key: str, reason: str, confirmed_by: str | None) -> list[str]:
+    registered = registered_worktrees(db, key)
+    recorded = _released_paths(db, key, reason)
+    pending = [path for path in registered if path not in recorded or (reason != "abandoned_release" and is_protected(path))]
+    for path in pending:
+        try:
+            if Path(path).exists() and is_protected(path):
+                release_worktree_protection(path)
+            if is_protected(path):
+                raise state.StateInconsistent("protection remains after release")
+        except OSError as exc:
+            raise state.StateInconsistent("could not release worktree protection") from exc
+    if pending:
+        payload: dict[str, object] = dict(paths=pending, reason=reason)
+        if confirmed_by is not None:
+            payload["confirmed_by"] = confirmed_by
+        state.append_event(db, key, "WORKSPACE_RELEASE", payload)
+    return pending
+
+
+def release_terminal_worktrees(state_db: StateDatabase, campaign_unit_key: str) -> list[str]:
+    if state.latest_status(state_db, campaign_unit_key) not in TERMINAL_RELEASE:
+        raise ReleaseNotAllowed("unit is not in a terminal release state")
+    return _release(state_db, campaign_unit_key, "terminal", None)
+
+
+def release_held_worktrees(state_db: StateDatabase, campaign_unit_key: str, *, confirmed_by: str) -> list[str]:
+    if not confirmed_by.strip() or state.latest_status(state_db, campaign_unit_key) not in HELD:
+        raise ReleaseNotAllowed("unit is not held or confirmation is empty")
+    return _release(state_db, campaign_unit_key, "held", confirmed_by)
+
+
+def release_abandoned_worktrees(state_db: StateDatabase, campaign_unit_key: str, *, confirmed_by: str) -> list[str]:
+    status = state.latest_status(state_db, campaign_unit_key)
+    if (not confirmed_by.strip() or status is None
+            or (status in TERMINAL and not is_abandoned(state_db, campaign_unit_key))):
+        raise ReleaseNotAllowed("unit is terminal or confirmation is empty")
+    return _release(state_db, campaign_unit_key, "abandoned_release", confirmed_by)
