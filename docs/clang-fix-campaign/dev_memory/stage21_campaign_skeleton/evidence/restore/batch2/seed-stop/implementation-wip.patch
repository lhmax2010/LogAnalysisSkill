+    path = case.root / f"{arch}-reproduce.json"
+    path.write_text(json.dumps(packet))
+    unit = state.get_unit(case.db, case.key)
+    state.append_event(case.db, case.key, "REPRODUCE", dict(
+        arch_norm=arch, outcome="matched", evidence_local=str(path),
+        evidence_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),
+        synthetic_zero_error=False, gbs_conf_sha256="a" * 64,
+        ci_evidence_sha256_used=unit.ci_evidence_sha256, build_log="offline.log", basis="test",
+    ))
+    return packet, path
+
+
+def test_later_round_resolves_previous_same_arch_not_latest_other_arch(proposal):
+    x86, _ = reproduce(proposal, "x86_64", "x86 previous")
+    reproduce(proposal, "aarch64", "other arch latest")
+    code, result = invoke(proposal, round_index=2)
+    assert code == 0 and result["mode"] == "generate"
+    assert proposal.described == [x86]
+
+
+def test_later_round_uses_convergence_instead_of_ci_or_baseline(proposal):
+    reproduce(proposal, "x86_64", "baseline")
+    state.create_round(proposal.db, proposal.key, round_index=1,
+                       edit_spec_ref=str(proposal.root / "prior.json"), edit_spec_sha256="b" * 64)
+    invocation = state.consume_build_invocation(
+        proposal.db, proposal.key, round_index=1, arch_norm="x86_64",
+    )
+    previous = dict(primary_error=dict(kind="compiler", message="previous build"))
+    path = proposal.root / "previous.json"
+    path.write_text(json.dumps(previous))
+    state.append_event(proposal.db, proposal.key, "CONVERGENCE", dict(
+        round_index=1, arch_norm="x86_64", invocation_event_id=invocation.event_id,
+        result="FAIL", verdict="advance", reason="build_failed", evidence_path=str(path),
+        evidence_sha256=hashlib.sha256(path.read_bytes()).hexdigest(), verification_id=None,
+        actual_changed_paths=["src/clang_case.c"], previous_basis="reproduce",
+        at="2026-11-04T00:00:00+00:00",
+    ))
+    reproduce(proposal, "aarch64", "other arch newer")
+    code, _ = invoke(proposal, round_index=2)
+    assert code == 0 and proposal.described == [previous]
+
+
+@pytest.mark.parametrize("failure", ["missing", "digest"])
+def test_later_round_missing_or_corrupt_evidence_does_not_fall_back_to_ci(proposal, failure):
+    if failure == "digest":
+        _, path = reproduce(proposal, "x86_64", "before")
+        path.write_text("{}")
+    code, result = invoke(proposal, round_index=2)
+    assert code == 4 and result["error_code"] == "REJECTED_STATE_INCONSISTENT"
+    assert not proposal.described and not proposal.output.exists()
+
+
+@pytest.mark.parametrize("part", ["marker", "origin", "head"])
+def test_source_identity_reused_without_writes(proposal, part):
+    git = SandboxGit()
+    if part == "marker":
+        (proposal.source / ".campaign_clone").write_text("{}")
+    elif part == "origin":
+        git.run(proposal.source, "remote", "set-url", "origin", "ssh://gerrit.invalid/other")
+    else:
+        git.run(proposal.source, "-c", "user.name=Test", "-c", "user.email=test@example.invalid",
+                "commit", "--allow-empty", "-m", "other")
+    code, result = invoke(proposal)
+    assert code == 4 and result["error_code"] == "REJECTED_IDENTITY_MISMATCH"
+    assert not proposal.queries and not proposal.output.exists()
+
+
+@pytest.mark.parametrize("arch,round_index", [("x86_64", 1), ("standard-x86_64", 0)])
+def test_invalid_arguments_before_queries(proposal, arch, round_index):
+    code, result = invoke(proposal, arch=arch, round_index=round_index)
+    assert code == 2 and result["error_code"] == "INVALID_ARGS"
+    assert not proposal.queries
+
+
+def test_output_cannot_target_source(proposal):
+    proposal.output = proposal.source / "new-directory"
+    code, result = invoke(proposal)
+    assert code == 2 and result["error_code"] == "INVALID_ARGS"
+    assert not proposal.output.exists()
+
+
+def test_cli_missing_arguments_json():
+    output = io.StringIO()
+    assert propose_fix.main([], stdout=output) == 2
+    assert json.loads(output.getvalue())["error_code"] == "INVALID_ARGS"
+
+
+@pytest.mark.parametrize("kind", ["imported", "change_ref", "none"])
+def test_real_kb_dataclass_query_and_all_three_paths(proposal, monkeypatch, kind):
+    kb = importlib.import_module("tizen_campaign_core.kb")
+    monkeypatch.setattr(tizen_campaign_core, "kb", kb)
+    unit = state.get_unit(proposal.db, proposal.key)
+    evidence = json.loads(Path(unit.ci_evidence_ref).read_text())
+    record = dict(
+        **kb.describe_evidence(evidence), package=unit.spec_name, gerrit_path=unit.project,
+        toolchain_profile=unit.toolchain_profile, baseline_commit=unit.base_commit,
+        verified_tree_sha="a" * 40, fix_strategy_initial="code", fix_strategy_final="code",
+        fix_summary="Use a defined return value", status="CI_VERIFIED",
+    )
+    precedent = None
+    if kind == "imported":
+        record.update(origin="imported_shelve", diff=DIFF, verified_tree_sha=None)
+    elif kind == "change_ref":
+        change = prepare_change(proposal)
+        record.update(change_ref=change["change_ref"], gerrit_url=change["gerrit_url"])
+    db = Path(proposal.settings["kb_db"])
+    if kind != "none":
+        precedent = kb.append(db, record).id
+    before = db.read_bytes() if db.exists() else None
+    code, result = invoke(proposal)
+    assert code == 0
+    assert result["mode"] == ("generate" if kind == "none" else "t1")
+    assert result["kb_precedent_ref"] == precedent
+    assert (db.read_bytes() if db.exists() else None) == before
+
+
+def test_corrupt_kb_is_not_silently_treated_as_no_precedent(proposal, monkeypatch):
+    kb = importlib.import_module("tizen_campaign_core.kb")
+    monkeypatch.setattr(tizen_campaign_core, "kb", kb)
+    path = Path(proposal.settings["kb_db"])
+    path.write_bytes(b"invalid json\n")
+    code, result = invoke(proposal)
+    assert code != 0 and result["error_code"] == "INVALID_ARGS"
+    assert path.read_bytes() == b"invalid json\n"
+    assert not proposal.output.exists()
+
+
+def test_existing_output_is_not_overwritten(proposal):
+    proposal.output.mkdir()
+    prior = proposal.output / "edit_spec.json"
+    prior.write_bytes(b"existing bound artifact")
+    code, result = invoke(proposal)
+    assert code == 2 and result["error_code"] == "INVALID_ARGS"
+    assert prior.read_bytes() == b"existing bound artifact"
+
+
+def test_unknown_unit_rejected_before_queries(proposal):
+    proposal.key = "unknown"
+    code, result = invoke(proposal)
+    assert code == 4 and result["error_code"] == "REJECTED_IDENTITY_MISMATCH"
+    assert not proposal.queries and not proposal.output.exists()
diff --git a/tests/unit/test_diff_format_patch_restore.py b/tests/unit/test_diff_format_patch_restore.py
new file mode 100644
index 0000000..a483e1c
--- /dev/null
+++ b/tests/unit/test_diff_format_patch_restore.py
@@ -0,0 +1,159 @@
+from __future__ import annotations
+
+import io
+import json
+import os
+import subprocess
+
+import pytest
+from tizen_build_verify.edit_spec_guard import validate_edit_spec
+from tizen_campaign_core.diff_to_edit_spec import DiffUnsupported, convert
+from tizen_campaign_repair.diff_cli import main
+
+
+@pytest.fixture
+def format_patch(tmp_path):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    home = tmp_path / "home"
+    home.mkdir()
+    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
+    env.update(HOME=str(home), XDG_CONFIG_HOME=str(home), GIT_CONFIG_NOSYSTEM="1",
+               GIT_CONFIG_GLOBAL=os.devnull, GIT_AUTHOR_NAME="Offline Test",
+               GIT_AUTHOR_EMAIL="offline@example.invalid", GIT_COMMITTER_NAME="Offline Test",
+               GIT_COMMITTER_EMAIL="offline@example.invalid")
+
+    def git(*args):
+        return subprocess.run(
+            ["git", "-c", "core.hooksPath=/dev/null", "-c", "commit.gpgSign=false",
+             "-C", str(repo), *args], env=env, check=True, capture_output=True,
+        ).stdout
+
+    git("init", "--quiet")
+    originals = {"one.c": "before\nold\nafter\n", "two.c": "first\nold\nlast\n"}
+    for name, text in originals.items():
+        (repo / name).write_text(text, encoding="utf-8")
+    git("add", ".")
+    git("commit", "--quiet", "-m", "Base")
+
+    def generate(count):
+        names = list(originals)[:count]
+        for name in names:
+            (repo / name).write_text(originals[name].replace("old", "new"), encoding="utf-8")
+        git("add", ".")
+        git("commit", "--quiet", "--signoff", "-m", "Fix offline fixture")
+        patch = git("format-patch", "--stdout", "-1").decode("utf-8")
+        for name, text in originals.items():
+            (repo / name).write_text(text, encoding="utf-8")
+        return repo, patch, names, originals
+
+    return generate
+
+
+@pytest.mark.parametrize("count", [1, 2])
+@pytest.mark.parametrize("ending", ["original", "no_blank", "extra_blanks", "version_at_eof"])
+def test_actual_format_patch_and_real_guard(format_patch, tmp_path, count, ending):
+    root, patch, names, originals = format_patch(count)
+    assert patch.startswith("From ")
+    assert "Subject: [PATCH] Fix offline fixture\n" in patch
+    assert "Signed-off-by: Offline Test <offline@example.invalid>\n" in patch
+    assert "\n-- \n" in patch
+    if ending == "no_blank":
+        patch = patch.rstrip("\n") + "\n"
+    elif ending == "extra_blanks":
+        patch += "\n\n"
+    elif ending == "version_at_eof":
+        patch = patch.rstrip("\n")
+    spec = convert(patch, root, "offline-fix")
+    validate_edit_spec(spec, str(root))
+    assert [edit["file"] for edit in spec["edits"]] == names
+    for edit in spec["edits"]:
+        assert edit["old"] == originals[edit["file"]]
+        assert edit["new"] == originals[edit["file"]].replace("old", "new")
+    path, output = tmp_path / "input.patch", tmp_path / "edit.json"
+    path.write_bytes(patch.encode("utf-8"))
+    stdout = io.StringIO()
+    assert main(["--diff", str(path), "--src-root", str(root), "--output", str(output),
+                 "--patch-name", "offline-fix"], stdout=stdout) == 0
+    assert json.loads(output.read_text()) == spec
+    validate_edit_spec(json.loads(output.read_text()), str(root))
+    assert {name: (root / name).read_text() for name in originals} == originals
+
+
+@pytest.mark.parametrize("version", ["2.39.2", "2.39.2.windows.1", "2.39.2-rc1"])
+def test_git_version_tokens_accepted(format_patch, version):
+    root, patch, _, _ = format_patch(1)
+    body, _ = patch.rsplit("-- \n", 1)
+    spec = convert(body + "-- \n" + version + "\n\n", root, "offline-fix")
+    validate_edit_spec(spec, str(root))
+
+
+@pytest.mark.parametrize("version", [
+    "2 arbitrary payload", "2.39.2 arbitrary payload", "2.39.2 ",
+    "2.39.2\tpayload", "2.39.2\rpayload", "2.39.2\x1bpayload",
+    "2.39.2\x7fpayload", "2.39.2\vpayload", "2.39.2+payload",
+    "2", "2windows.1",
+])
+def test_invalid_version_tokens_rejected(format_patch, version):
+    root, patch, _, _ = format_patch(1)
+    body, _ = patch.rsplit("-- \n", 1)
+    with pytest.raises(DiffUnsupported, match="^unparsed_patch_content$"):
+        convert(body + "-- \n" + version + "\n", root, "offline-fix")
+
+
+@pytest.mark.parametrize("placement", [
+    "after_signature", "between_files", "before_hunk", "before_headers",
+    "between_hunks", "missing_version", "empty_version", "non_version",
+    "extra_version", "separator_crlf", "blank_before_signature",
+])
+def test_signature_outside_terminal_position_rejected(format_patch, placement):
+    root, patch, _, _ = format_patch(2)
+    body, signature = patch.rsplit("-- \n", 1)
+    footer = "-- \n" + signature
+    if placement == "after_signature":
+        patch += "extra content\n"
+    elif placement == "between_files":
+        position = body.index("diff --git ", body.index("diff --git ") + 1)
+        patch = body[:position] + footer + body[position:]
+    elif placement == "before_hunk":
+        position = body.index("@@ ")
+        patch = body[:position] + footer + body[position:]
+    elif placement == "before_headers":
+        patch = footer + body
+    elif placement == "between_hunks":
+        patch += "@@ -2 +2 @@\n-old\n+new\n"
+    elif placement == "missing_version":
+        patch = body + "-- \n"
+    elif placement == "empty_version":
+        patch = body + "-- \n\n"
+    elif placement == "non_version":
+        patch = body + "-- \nextra content\n"
+    elif placement == "extra_version":
+        patch += "2.39.2\n"
+    elif placement == "separator_crlf":
+        patch = body + "-- \r\n" + signature
+    else:
+        patch = body + "\n" + footer
+    with pytest.raises(DiffUnsupported, match="^unparsed_patch_content$"):
+        convert(patch, root, "offline-fix")
+
+
+@pytest.mark.parametrize("existing_output", [False, True])
+def test_latin1_diff_is_unsupported_encoding(format_patch, tmp_path, existing_output):
+    root, patch, _, originals = format_patch(1)
+    path, output = tmp_path / "latin1.patch", tmp_path / "edit.json"
+    path.write_bytes(patch.replace("Fix offline fixture", "Fix caf\u00e9").encode("latin-1"))
+    if existing_output:
+        output.write_bytes(b"existing output\n")
+    stdout = io.StringIO()
+    assert main(["--diff", str(path), "--src-root", str(root), "--output", str(output),
+                 "--patch-name", "offline-fix"], stdout=stdout) == 4
+    assert json.loads(stdout.getvalue()) == {
+        "error_code": "DIFF_CONVERT_UNSUPPORTED", "reason": "unsupported_encoding",
+    }
+    if existing_output:
+        assert output.read_bytes() == b"existing output\n"
+    else:
+        assert not output.exists()
+    assert not list(tmp_path.glob(".edit-spec-*"))
+    assert {name: (root / name).read_text() for name in originals} == originals
