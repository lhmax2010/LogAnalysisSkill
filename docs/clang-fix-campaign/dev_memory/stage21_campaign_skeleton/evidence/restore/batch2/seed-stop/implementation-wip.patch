diff --git a/tizen-campaign-core/scripts/tizen_campaign_core/kb.py b/tizen-campaign-core/scripts/tizen_campaign_core/kb.py
new file mode 100644
index 0000000..bdfba03
--- /dev/null
+++ b/tizen-campaign-core/scripts/tizen_campaign_core/kb.py
@@ -0,0 +1,362 @@
+"""Validated, atomic JSONL knowledge records and conservative T1/T2 retrieval."""
+
+from __future__ import annotations
+
+import copy
+import fcntl
+import hashlib
+import json
+import math
+import os
+import re
+import tempfile
+import uuid
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from tizen_convergence_judge.convergence import primary_fingerprint
+
+SCHEMA_VERSION = "clang_kb/v1"
+NORMALIZER_VERSION = "campaign.v1(parity: convergence)"
+STATUSES = ("NEW", "CI_VERIFIED", "MERGED")
+_SHA = re.compile(r"[0-9a-fA-F]{40}")
+_REF = re.compile(r"refs/changes/[0-9]{2}/[0-9]+/[0-9]+")
+_WARNING = re.compile(r"-W[A-Za-z0-9_+=.-]+")
+_NULLABLE = (
+    "origin", "reused_from", "quickbuild_id", "sandbox_branch", "gerrit_url",
+    "change_ref", "change_id", "promoted_at",
+)
+_LISTS = ("warning_flags", "files", "error_lines", "verified_archs")
+_INSTANCE = (
+    "package", "gerrit_path", "baseline_commit", "verified_tree_sha",
+    "fix_strategy_initial", "fix_strategy_final",
+)
+_TEXT = (
+    "diagnosed_flag", "root_cause_category", "toolchain_profile",
+    "error_signature_raw", "error_signature_normalized", "fix_summary",
+)
+
+
+class KbSchemaError(ValueError):
+    """Invalid record, query, or transition; no partial write is permitted."""
+
+
+KbError = KbSchemaError
+
+
+class KbCorrupt(KbError):
+    """An existing JSONL cannot be trusted in its entirety."""
+
+
+@dataclass(frozen=True)
+class QueryResult:
+    t1: list[dict[str, Any]]
+    t2: list[dict[str, Any]]
+
+
+@dataclass(frozen=True)
+class AppendResult:
+    id: str
+    deduped: bool
+
+
+def normalize_signature(value: str) -> str:
+    """Independent implementation, golden-tested against convergence."""
+    value = value.lower()
+    value = re.sub(r"(:\d+){1,2}", ":#", value)
+    value = re.sub(r"\b\d+\b", "#", value)
+    return re.sub(r"\s+", " ", value).strip()
+
+
+def describe_evidence(evidence: dict[str, Any]) -> dict[str, Any]:
+    primary = evidence.get("primary_error")
+    if not isinstance(primary, dict):
+        raise KbError("missing_primary_error")
+    raw = primary.get("message")
+    if not isinstance(raw, str) or not raw.strip():
+        raise KbError("missing_primary_message")
+    fingerprint = primary_fingerprint(evidence, touched_files=None)
+    if fingerprint is None:
+        raise KbError("missing_primary_fingerprint")
+    category = primary.get("semantic_class") or primary.get("kind")
+    candidates = evidence.get("root_cause_candidates", [])
+    if not isinstance(candidates, list):
+        raise KbError("invalid_root_cause_candidates")
+    for candidate in candidates:
+        if (isinstance(candidate, dict) and primary.get("id") is not None
+                and candidate.get("event_id") == primary["id"]
+                and candidate.get("semantic_class")):
+            category = candidate["semantic_class"]
+            break
+    if not isinstance(category, str) or not category:
+        raise KbError("missing_root_cause_category")
+    flags = set(_WARNING.findall(raw))
+    for value in (primary.get("warning_option"), fingerprint.diagnostic_code):
+        if isinstance(value, str):
+            flags.update(_WARNING.findall(value))
+    return {
+        "diagnosed_flag": fingerprint.diagnostic_code,
+        "root_cause_category": category,
+        "warning_flags": sorted(flags),
+        "error_signature_raw": raw,
+    }
+
+
+def make_record(**metadata: Any) -> dict[str, Any]:
+    """Complete defaults, without manufacturing provenance or a final strategy."""
+    record: dict[str, Any] = {key: None for key in _NULLABLE}
+    record.update({key: [] for key in _LISTS})
+    record.update(schema_version=SCHEMA_VERSION, record_type="instance", status="NEW",
+                  confidence=0, normalizer_version=NORMALIZER_VERSION)
+    record.update(copy.deepcopy(metadata))
+    if isinstance(record.get("error_signature_raw"), str):
+        record.setdefault("error_signature_normalized",
+                          normalize_signature(record["error_signature_raw"]))
+    _validate(record, stored=False)
+    return record
+
+
+def _text(value: Any) -> bool:
+    return isinstance(value, str) and bool(value.strip())
+
+
+def _timestamp(value: Any) -> bool:
+    if not isinstance(value, str):
+        return False
+    try:
+        stamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
+        return stamp.tzinfo is not None and stamp.utcoffset() == timezone.utc.utcoffset(stamp)
+    except ValueError:
+        return False
+
+
+def _validate(record: dict[str, Any], *, stored: bool) -> None:
+    required = set(_NULLABLE + _LISTS + _INSTANCE + _TEXT) | {
+        "schema_version", "record_type", "status", "confidence", "normalizer_version",
+    }
+    if stored:
+        required |= {"id", "dedupe_key", "created_at"}
+    if required - record.keys():
+        raise KbError("missing_record_fields:" + ",".join(sorted(required - record.keys())))
+    if record["schema_version"] != SCHEMA_VERSION:
+        raise KbError("invalid_schema_version")
+    if record["record_type"] not in ("instance", "seed"):
+        raise KbError("invalid_record_type")
+    if record["status"] not in STATUSES:
+        raise KbError("invalid_status")
+    if record["normalizer_version"] != NORMALIZER_VERSION:
+        raise KbError("invalid_normalizer_version")
+    for key in _TEXT:
+        if not _text(record[key]):
+            raise KbError("invalid_" + key)
+    if record["error_signature_normalized"] != normalize_signature(record["error_signature_raw"]):
+        raise KbError("signature_normalization_mismatch")
+    for key in _INSTANCE:
+        value = record[key]
+        if value is None and (record["record_type"] == "seed" or (
+            key == "verified_tree_sha" and record["origin"] == "imported_shelve"
+        )):
+            continue
+        if not _text(value):
+            raise KbError("invalid_" + key)
+    for key in ("baseline_commit", "verified_tree_sha"):
+        if record[key] is not None and not _SHA.fullmatch(record[key]):
+            raise KbError("invalid_" + key)
+    for key in ("fix_strategy_initial", "fix_strategy_final"):
+        if record[key] is not None and record[key] not in ("code", "cherry_pick", "suppress"):
+            raise KbError("invalid_" + key)
+    for key in _LISTS:
+        value = record[key]
+        if record["record_type"] == "seed" and key != "warning_flags" and value is None:
+            continue
+        if not isinstance(value, list):
+            raise KbError("invalid_" + key)
+        if key == "error_lines":
+            if any(not ((type(item) is int and item > 0) or _text(item)) for item in value):
+                raise KbError("invalid_error_lines")
+        elif any(not _text(item) for item in value):
+            raise KbError("invalid_" + key)
+    for key in _NULLABLE:
+        value = record[key]
+        if value is None:
+            continue
+        if key == "quickbuild_id":
+            if type(value) is not int or value <= 0:
+                raise KbError("invalid_quickbuild_id")
+        elif not _text(value):
+            raise KbError("invalid_" + key)
+    confidence = record["confidence"]
+    if (isinstance(confidence, bool) or not isinstance(confidence, (int, float))
+            or not math.isfinite(confidence)):
+        raise KbError("invalid_confidence")
+    if record["change_ref"] is not None and not _REF.fullmatch(record["change_ref"]):
+        raise KbError("invalid_change_ref")
+    if record["origin"] == "imported_shelve":
+        if record["record_type"] != "instance" or not _text(record.get("diff")):
+            raise KbError("invalid_imported_diff")
+        try:
+            record["diff"].encode("utf-8", errors="strict")
+        except UnicodeError as exc:
+            raise KbError("invalid_diff_encoding") from exc
+    if record["promoted_at"] is not None and not _timestamp(record["promoted_at"]):
+        raise KbError("invalid_promoted_at")
+    if stored:
+        try:
+            if str(uuid.UUID(record["id"])) != record["id"]:
+                raise ValueError
+        except (ValueError, TypeError, AttributeError) as exc:
+            raise KbError("invalid_id") from exc
+        if not _timestamp(record["created_at"]):
+            raise KbError("invalid_created_at")
+        if record["dedupe_key"] != dedupe_key(record):
+            raise KbError("dedupe_key_mismatch")
+
+
+def dedupe_key(record: dict[str, Any]) -> str:
+    tree = record["verified_tree_sha"]
+    if record.get("origin") == "imported_shelve":
+        tree = "imported:" + hashlib.sha256(record["diff"].encode("utf-8")).hexdigest()
+    parts = [record["package"], record["gerrit_path"], record["baseline_commit"], tree,
+             record["diagnosed_flag"], record["toolchain_profile"],
+             record["error_signature_normalized"]]
+    if any(not isinstance(part, str) for part in parts):
+        raise KbError("seed_dedupe_encoding_requires_ruling")
+    return hashlib.sha256("".join(parts).encode("utf-8")).hexdigest()
+
+
+def _pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise KbCorrupt("duplicate_json_key")
+        result[key] = value
+    return result
+
+
+def records(db: Path) -> list[dict[str, Any]]:
+    """Read one atomic snapshot; any corrupt row invalidates the whole database."""
+    try:
+        data = db.read_bytes().decode("utf-8", errors="strict")
+    except FileNotFoundError:
+        return []
+    except UnicodeError as exc:
+        raise KbCorrupt("invalid_jsonl_encoding") from exc
+    result: list[dict[str, Any]] = []
+    ids: set[str] = set()
+    keys: set[str] = set()
+    for line in data.splitlines():
+        try:
+            record = json.loads(line, object_pairs_hook=_pairs)
+            if not isinstance(record, dict):
+                raise KbError("record_not_object")
+            _validate(record, stored=True)
+            if record["id"] in ids or record["dedupe_key"] in keys:
+                raise KbError("duplicate_record")
+            ids.add(record["id"])
+            keys.add(record["dedupe_key"])
+            result.append(record)
+        except (ValueError, TypeError, KeyError) as exc:
+            raise KbCorrupt("invalid_jsonl_record") from exc
+    return result
+
+
+def _write(db: Path, rows: list[dict[str, Any]]) -> None:
+    payload = "".join(json.dumps(row, ensure_ascii=False, sort_keys=True, allow_nan=False)
+                      + "\n" for row in rows).encode("utf-8")
+    descriptor, name = tempfile.mkstemp(prefix="." + db.name + ".", dir=db.parent)
+    temporary = Path(name)
+    try:
+        with os.fdopen(descriptor, "wb") as stream:
+            stream.write(payload)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, db)
+        parent = os.open(db.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(parent)
+        finally:
+            os.close(parent)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def append(db: Path, record: dict[str, Any]) -> AppendResult:
+    candidate = make_record(**record)
+    key = dedupe_key(candidate)
+    db.parent.mkdir(parents=True, exist_ok=True)
+    with (db.parent / ".lock").open("a+b") as lock:
+        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+        rows = records(db)
+        for row in rows:
+            if row["dedupe_key"] == key:
+                return AppendResult(row["id"], True)
+        candidate.update(id=str(uuid.uuid4()), dedupe_key=key,
+                         created_at=datetime.now(timezone.utc).isoformat())
+        _validate(candidate, stored=True)
+        _write(db, rows + [candidate])
+        return AppendResult(candidate["id"], False)
+
+
+def promote(db: Path, id: str, to: str) -> dict[str, Any]:
+    if to not in STATUSES:
+        raise KbError("invalid_status")
+    db.parent.mkdir(parents=True, exist_ok=True)
+    with (db.parent / ".lock").open("a+b") as lock:
+        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+        rows = records(db)
+        for row in rows:
+            if row["id"] != id:
+                continue
+            if STATUSES.index(to) < STATUSES.index(row["status"]):
+                raise KbError("status_downgrade")
+            if row["status"] != to:
+                row.update(status=to, promoted_at=datetime.now(timezone.utc).isoformat())
+                _validate(row, stored=True)
+                _write(db, rows)
+            return row
+        raise KbError("unknown_record_id")
+
+
+def query(
+    db: Path, *, diagnosed_flag: str, package: str | None = None,
+    gerrit_path: str | None = None, category: str | None = None,
+    warning_flags: list[str] | None = None, toolchain_profile: str | None = None,
+    error_signature: str | None = None, min_status: str = "CI_VERIFIED", limit_t2: int = 5,
+) -> QueryResult:
+    if not _text(diagnosed_flag) or min_status not in STATUSES:
+        raise KbError("invalid_query")
+    if type(limit_t2) is not int or limit_t2 < 0:
+        raise KbError("invalid_limit_t2")
+    if warning_flags is not None and (
+        not isinstance(warning_flags, list) or any(not _text(v) for v in warning_flags)
+    ):
+        raise KbError("invalid_warning_flags")
+    for value in (package, gerrit_path, category, toolchain_profile, error_signature):
+        if value is not None and not _text(value):
+            raise KbError("invalid_query")
+    rows = [row for row in records(db) if row["status"] != "NEW"
+            and STATUSES.index(row["status"]) >= STATUSES.index(min_status)]
+    complete = all(value is not None for value in (
+        package, gerrit_path, category, warning_flags, toolchain_profile, error_signature,
+    ))
+    signature = normalize_signature(error_signature) if error_signature is not None else None
+    t1 = [row for row in rows if complete and row["record_type"] == "instance"
+          and row["package"] == package and row["gerrit_path"] == gerrit_path
+          and row["diagnosed_flag"] == diagnosed_flag and row["root_cause_category"] == category
+          and set(row["warning_flags"]) == set(warning_flags or [])
+          and row["toolchain_profile"] == toolchain_profile
+          and row["error_signature_normalized"] == signature]
+    t2 = [row for row in rows if row["diagnosed_flag"] == diagnosed_flag
+          or (category is not None and row["root_cause_category"] == category)]
+
+    def rank(row: dict[str, Any]) -> tuple[int, float]:
+        exact = category is not None and row["root_cause_category"] == category
+        if row["record_type"] == "seed":
+            priority = 0 if exact else 1
+        else:
+            priority = 2 if row["status"] == "MERGED" and exact else 3
+        return priority, -float(row["confidence"])
+
+    return QueryResult(t1=t1, t2=sorted(t2, key=rank)[:limit_t2])
diff --git a/tizen-campaign-repair/scripts/tizen_campaign_repair/propose_fix.py b/tizen-campaign-repair/scripts/tizen_campaign_repair/propose_fix.py
