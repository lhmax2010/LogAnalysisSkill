+
+
+@pytest.fixture
+def ready(case):
+    case.settings.update(
+        gerrit_user="test", git_author_identity="Test <test@example.invalid>",
+        git_committer_identity="Test <test@example.invalid>", push_timeout_sec=120,
+        push_retry=1, target_arches=["aarch64", "armv7l", "x86_64"],
+    )
+    case.args.config.write_text(yaml.safe_dump(case.settings))
+    binary = case.transport[0].parent / "bin/gbs"
+    binary.write_text("#!/bin/sh\nexit 0\n")
+    binary.chmod(0o700)
+    return case
+
+
+def execute(c):
+    output = io.StringIO()
+    code = start_check.main([
+        "--config", str(c.args.config), "--state-root", str(c.root / "state"),
+        "--project", c.args.project,
+    ], stdout=output)
+    return code, json.loads(output.getvalue())
+
+
+def test_start_all_checks_fake_ssh_full_project(ready):
+    code, result = execute(ready)
+    assert code == 0 and len(result["checks"]) == 5
+    calls = [json.loads(line) for line in ready.transport[2].read_text().splitlines()]
+    assert calls[-1] == {"command": "git-upload-pack", "path": str(ready.transport[1])}
+
+
+@pytest.mark.parametrize("failure", ["config", "clang_conf", "gbs", "gerrit", "state_directory"])
+def test_start_each_check_failure(ready, failure):
+    if failure == "config":
+        del ready.settings["git_author_identity"]
+    elif failure == "clang_conf":
+        ready.settings["clang_conf_path"] += ".missing"
+    elif failure == "gbs":
+        (ready.transport[0].parent / "bin/gbs").write_text("#!/bin/sh\nexit 3\n")
+    elif failure == "gerrit":
+        ready.args.project = "missing/project"
+    else:
+        ready.root.mkdir(parents=True)
+        (ready.root / "state").write_text("not a directory")
+    ready.args.config.write_text(yaml.safe_dump(ready.settings))
+    code, result = execute(ready)
+    assert code == 4 and result["error_code"] == "PREFLIGHT_FAILED"
+    check = next(c for c in result["checks"] if c["name"] == failure)
+    assert not check["passed"]
+    if failure == "gerrit":
+        assert check["reason"] == "unreachable"
+
+
+@pytest.mark.parametrize("project", [None, "../escape", "-option", "repo/", "repo name"])
+def test_start_invalid_projects_before_subprocess(ready, monkeypatch, project):
+    def forbidden(*args, **kwargs):
+        raise AssertionError("subprocess must not start")
+    monkeypatch.setattr(subprocess, "run", forbidden)
+    argv = ["--config", str(ready.args.config), "--state-root", str(ready.root / "state")]
+    if project is not None:
+        argv += ["--project=" + project]
+    assert start_check.main(argv, stdout=io.StringIO()) == 4
+
+
+def test_local_path_rejected_by_both_intake_and_preflight(ready):
+    ready.settings["gerrit_ssh_base"] = str(ready.transport[0])
+    ready.args.config.write_text(yaml.safe_dump(ready.settings))
+    code, result = execute(ready)
+    assert code == 4
+    assert next(c for c in result["checks"] if c["name"] == "gerrit")["reason"] == "config_not_ssh"
+    with pytest.raises(_StepError) as error:
+        intake.add_unit(ready.args)
+    assert error.value.code == "REJECTED_IDENTITY_MISMATCH"
+    assert not (ready.root / "src").exists()
+    assert not list(ready.root.glob(".src.staging-*"))
