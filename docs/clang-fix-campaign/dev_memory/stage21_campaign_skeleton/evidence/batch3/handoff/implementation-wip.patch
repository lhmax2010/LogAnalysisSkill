+
+
+@pytest.fixture
+def case(tmp_path, monkeypatch, transport):
+    c = Campaign(tmp_path / "case", monkeypatch)
+    monkeypatch.setenv("SKEL_FAKE_SSH_ROOT", str(c.remote_base))
+    settings = yaml.safe_load(c.config.read_text())
+    settings["gerrit_ssh_base"] = "ssh://gerrit.invalid:29418"
+    c.config.write_text(yaml.safe_dump(settings))
+    git(c.src, "remote", "set-url", "origin", "ssh://gerrit.invalid:29418/project")
+    outcome = sandbox.sandbox_submit(c.options)
+    assert outcome.exit_code == 0, outcome.payload
+    c.derived = outcome.payload["derived_commit_sha"]
+    for arch in sandbox.ARCH_ORDER:
+        state.append_event(c.db, c.key, "REPRODUCE", dict(
+            arch_norm=arch, outcome="matched", evidence_local=f"{arch}.json",
+            evidence_sha256="e" * 64, synthetic_zero_error=False, gbs_conf_sha256="f" * 64,
+            ci_evidence_sha256_used="e" * 64, build_log="local.log", basis={},
+        ))
+    conn = c.db.connect()
+    try:
+        with conn:
+            state._insert_qb_profile_on_connection(
+                conn, "tizen", profile_json='{"qb_pass_requires_accept":false}',
+            )
+    finally:
+        conn.close()
+    c.seq = state.create_qb_request(c.db, c.key, request_id="request-one", sbs_target="project@" + c.derived)
+    state.append_qb_event(c.db, request_seq=c.seq, event_type="BUILD_BOUND", qb_build_id="101")
+    c.result = {key: None for key in review.RESULT_KEYS}
+    c.result.update(
+        qb_build_id="101", child_build_id="102", status="PASS", sbs_target_echo="project@" + c.derived,
+        request_marker_echo="clang-fix-campaign request=request-one", snapshot_drift_accepted=False,
+        snapshot_used="test-snapshot", params_echo={k: "" for k in (
+            "BUILD_TYPE", "BUILD_REFERENCE", "SNAPSHOT_NUM", "PROJECT_BRANCH", "FAIL_FAST",
+        )}, child_params_echo=dict(BUILD_REFERENCE="Ref. Snapshot", SNAPSHOT_NUM_URL="test"),
+    )
+    c.result_path = c.root / "result.json"
+    c.result_path.write_text(json.dumps(c.result))
+    state.append_qb_event(
+        c.db, request_seq=c.seq, event_type="RESULT", qb_build_id="101", status="PASS",
+        sbs_target_echo="project@" + c.derived,
+        qb_result_sha256=hashlib.sha256(c.result_path.read_bytes()).hexdigest(),
+        qb_result_ref="qb_results/request-one/result.json",
+    )
+    state.append_status(c.db, c.key, "SANDBOX_QB_PASS")
+    c.review_options = review.ReviewOptions("v0,v1,v2", c.db.path, c.config, c.result_path, "refs/for/tizen")
+    c.before_refs = git(c.remote, "show-ref")
+    c.before_change_ids = c.sql("SELECT * FROM campaign_change_ids")
+    return c
+
+
+def assert_rejected(c, outcome, code):
+    assert outcome.exit_code == 4, outcome.payload
+    assert outcome.payload["error_code"] == code
+    assert git(c.remote, "show-ref") == c.before_refs
+    assert not c.sql("SELECT 1 FROM campaign_gate_events WHERE event_type='REVIEW'")
+
+
+def test_review_success_and_cached_identity(case):
+    result = review.run(case.review_options)
+    assert result.exit_code == 0, result.payload
+    assert git(case.remote, "rev-parse", "refs/for/tizen") == case.derived
+    assert result.payload["review_url"] is None
+    assert state.latest_status(case.db, case.key) == "REVIEW_PUSHED"
+    assert [tuple(r) for r in case.sql("SELECT * FROM campaign_change_ids")] == [tuple(r) for r in case.before_change_ids]
+    count = len(case.events())
+    assert review.run(case.review_options).payload["action"] == "already_pushed"
+    assert len(case.events()) == count
+
+
+@pytest.mark.parametrize("gate", ["aggregate", "qb_bytes", "edit_bytes", "policy", "a2", "toctou"])
+def test_review_six_gate_refusals(case, monkeypatch, gate):
+    code = "REJECTED_STATE_INCONSISTENT"
+    if gate == "aggregate":
+        state.create_round(case.db, case.key, round_index=2, edit_spec_ref=str(case.root / "next.json"), edit_spec_sha256="9" * 64)
+        code = "REJECTED_ROUND_SUPERSEDED"
+    elif gate == "qb_bytes":
+        case.result_path.write_text(case.result_path.read_text() + " ")
+        code = "REJECTED_QB_BINDING_MISMATCH"
+    elif gate == "edit_bytes":
+        case.spec.write_text(case.spec.read_text() + " ")
+        code = "REJECTED_EDIT_SPEC_REBIND_MISMATCH"
+    elif gate == "policy":
+        original = review.evaluate
+        monkeypatch.setattr(review, "evaluate", lambda *a, **k: replace(original(*a, **k), fix_strategy_final="suppress"))
+    elif gate == "a2":
+        case.sql("DELETE FROM campaign_gate_events WHERE event_type='REPRODUCE'")
+        code = "REJECTED_REVIEW_GATE"
+    else:
+        original = sandbox.toctou_recheck
+        def changed(*args, **kwargs):
+            (case.copies[0] / "file.c").write_text("changed\n")
+            return original(*args, **kwargs)
+        monkeypatch.setattr(sandbox, "toctou_recheck", changed)
+        code = "REJECTED_WORKTREE_DIRTY"
+    assert_rejected(case, review.run(case.review_options), code)
+
+
+def test_latest_request_pending_exact_message(case):
+    state.create_qb_request(case.db, case.key, request_id="latest-real-request", sbs_target="project@" + case.derived)
+    result = review.run(case.review_options)
+    assert_rejected(case, result, "REJECTED_QB_REQUEST_PENDING")
+    assert result.payload["message"] == (
+        "该 unit 最新的验证请求(request_id=latest-real-request)还没有结果。若 qb-result-fetch 曾报告结果无法识别"
+        "(QB_RESULT_UNRECOGNIZED,例如各架构状态非空或快照漂移;可在运行 qb-result-fetch 时所用的 state_root "
+        "下查看该 request 的 trace 确认),重读不会改变结果,请按其输出的指引处置,或用 "
+        "campaign-release-worktrees --abandon 放弃该 unit;否则稍后重跑 qb-result-fetch。"
+    )
+
+
+def test_abandoned_pass_rejected_before_copies(case):
+    state.append_event(case.db, case.key, "WORKSPACE_RELEASE", dict(paths=[], reason="abandoned", confirmed_by="test"))
+    for path in case.copies:
+        (path / ".ci_triage_protected").unlink()
+    assert_rejected(case, review.run(case.review_options), "REJECTED_UNIT_ABANDONED")
+    assert state.latest_status(case.db, case.key) == "SANDBOX_QB_PASS"
+    assert report.report(case.db)[0]["workspace_status"] == "已放弃"
+
+
+def test_review_holds_all_locks_through_toctou_and_push(case, monkeypatch):
+    original = sandbox.toctou_recheck
+    seen = []
+    def during(*args, **kwargs):
+        with pytest.raises(sandbox._Reject) as error:
+            report.release(case.db, case.key, {"campaign_workspace": str(case.ws)}, "tester", True)
+        seen.append(error.value.code)
+        return original(*args, **kwargs)
+    monkeypatch.setattr(sandbox, "toctou_recheck", during)
+    result = review.run(case.review_options)
+    assert result.exit_code == 0, result.payload
+    assert seen == ["CAMPAIGN_STATE_BUSY"]
+    assert not any(json.loads(r[1]).get("reason") == "abandoned" for r in case.events())
+
+
+def test_abandon_locks_block_review(case):
+    with sandbox._locks(case.unit_root):
+        assert_rejected(case, review.run(case.review_options), "CAMPAIGN_STATE_BUSY")
+
+
+@pytest.mark.parametrize("target", ["refs/for/other", "refs/heads/tizen"])
+def test_review_target_bound_to_unit(case, target):
+    assert_rejected(case, review.run(replace(case.review_options, review_target=target)), "REJECTED_REVIEW_TARGET_MISMATCH")
