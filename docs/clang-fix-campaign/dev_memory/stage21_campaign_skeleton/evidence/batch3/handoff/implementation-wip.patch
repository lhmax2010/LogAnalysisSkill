index 0000000..9e34c4b
--- /dev/null
+++ b/tizen-campaign-intake/scripts/tizen_campaign_intake/start_check.py
@@ -0,0 +1,141 @@
+"""Five offline-friendly campaign startup checks; no QuickBuild interaction."""
+
+from __future__ import annotations
+
+import json
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+from typing import Any, TextIO
+
+import yaml
+from tizen_campaign_core._campaign_io import JsonParser
+from tizen_campaign_core._sandbox_git import SandboxGit
+
+REQUIRED = (
+    "gerrit_ssh_base",
+    "gerrit_user",
+    "git_author_identity",
+    "git_committer_identity",
+    "push_timeout_sec",
+    "push_retry",
+    "target_arches",
+    "campaign_workspace",
+    "clang_conf_path",
+)
+
+
+def check(config: Path, state_root: Path, projects: list[str]) -> dict[str, Any]:
+    # Same project-name grammar as qb_trigger's preflight, before any subprocess.
+    valid_projects = bool(projects) and all(
+        re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/+-]*", p) is not None
+        and ".." not in p
+        and not p.endswith("/")
+        for p in projects
+    )
+    try:
+        settings = yaml.safe_load(config.read_text(encoding="utf-8"))
+        if not isinstance(settings, dict):
+            settings = {}
+    except (OSError, yaml.YAMLError):
+        settings = {}
+    missing = [key for key in REQUIRED if settings.get(key) in (None, "")]
+    checks: list[dict[str, Any]] = [
+        dict(
+            name="config",
+            passed=not missing and valid_projects,
+            reason="invalid_project" if not valid_projects else "missing_keys" if missing else None,
+            missing_keys=missing,
+        )
+    ]
+    conf = settings.get("clang_conf_path")
+    checks.append(
+        dict(
+            name="clang_conf",
+            passed=isinstance(conf, str)
+            and Path(conf).is_file()
+            and "/reference/" not in str(Path(conf).resolve())
+            and "/reference/" not in conf,
+            reason=None,
+        )
+    )
+    base = settings.get("gerrit_ssh_base")
+    valid_base = isinstance(base, str) and base.startswith("ssh://")
+    if missing or not valid_projects:
+        checks.extend(
+            dict(name=name, passed=False, reason="config_failed")
+            for name in ("gbs", "gerrit", "state_directory")
+        )
+    else:
+        try:
+            gbs = subprocess.run(["gbs", "--version"], capture_output=True, timeout=30, check=False)
+            ok = gbs.returncode == 0
+        except (OSError, subprocess.SubprocessError):
+            ok = False
+        checks.append(dict(name="gbs", passed=ok, reason=None if ok else "unavailable"))
+        accessible = []
+        if valid_base:
+            assert isinstance(base, str)
+            for project in projects:
+                try:
+                    result = SandboxGit().run(
+                        None,
+                        "ls-remote",
+                        base.rstrip("/") + "/" + project,
+                        remote=True,
+                        check=False,
+                    )
+                    accessible.append(result.returncode == 0)
+                except (OSError, subprocess.SubprocessError):
+                    accessible.append(False)
+        checks.append(
+            dict(
+                name="gerrit",
+                passed=valid_base and all(accessible),
+                reason="config_not_ssh"
+                if not valid_base
+                else "unreachable"
+                if not all(accessible)
+                else None,
+                projects=[
+                    dict(project=p, passed=ok) for p, ok in zip(projects, accessible, strict=False)
+                ],
+            )
+        )
+        try:
+            state_root.mkdir(parents=True, exist_ok=True)
+            with tempfile.TemporaryFile(dir=state_root) as stream:
+                stream.write(b"startup-check")
+                stream.flush()
+            writable = True
+        except OSError:
+            writable = False
+        checks.append(
+            dict(name="state_directory", passed=writable, reason=None if writable else "unwritable")
+        )
+    ok = all(row["passed"] for row in checks)
+    return dict(checks=checks, error_code=None if ok else "PREFLIGHT_FAILED")
+
+
+def main(argv: list[str], *, stdout: TextIO) -> int:
+    parser = JsonParser(prog="campaign-start-check")
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--state-root", type=Path, required=True)
+    parser.add_argument("--project", action="append", required=True)
+    try:
+        args = parser.parse_args(argv)
+        result = check(args.config, args.state_root, args.project)
+    except ValueError:
+        result = dict(
+            error_code="PREFLIGHT_FAILED",
+            checks=[
+                dict(
+                    name="config",
+                    passed=False,
+                    reason="invalid_args",
+                )
+            ],
+        )
+    print(json.dumps(result, sort_keys=True), file=stdout)
+    return 0 if result["error_code"] is None else 4
diff --git a/tizen-review-submit/scripts/tizen_review_submit/review_submit.py b/tizen-review-submit/scripts/tizen_review_submit/review_submit.py
new file mode 100644
index 0000000..924dd2c
--- /dev/null
+++ b/tizen-review-submit/scripts/tizen_review_submit/review_submit.py
@@ -0,0 +1,473 @@
+"""Review publication authorized only by bound campaign and QuickBuild evidence."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import subprocess
+from collections.abc import Mapping
+from contextlib import ExitStack
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, TextIO, cast
+
+from tizen_campaign_core import campaign_state as state
+from tizen_campaign_core._campaign_io import JsonParser
+from tizen_campaign_core._campaign_workspace import _unit_hash
+from tizen_campaign_core.aggregate import aggregate_verifications
+from tizen_campaign_core.campaign_lifecycle import is_abandoned
+from tizen_campaign_core.submission_identity import compute_submission_key
+from tizen_campaign_core.suppress_policy import PolicyInputError, SourceKind, evaluate
+from tizen_ci_shared.state import StateDatabase
+from tizen_sandbox_submit import sandbox_submit as sandbox
+
+RESULT_KEYS = frozenset(
+    "qb_build_id child_build_id status sbs_target_echo per_arch_status accepted "
+    "configuration_path child_configuration_path parent_status_text child_status_text "
+    "child_build_result_text child_failed_step child_error_message request_marker_echo "
+    "params_echo child_params_echo snapshot_used snapshot_drift_accepted pkg_list_echo "
+    "evidence fetched_at".split()
+)
+
+
+@dataclass(frozen=True)
+class ReviewOptions:
+    verification_ids: str
+    state_db: Path
+    config: Path
+    qb_result: Path
+    review_target: str
+
+
+@dataclass(frozen=True)
+class QbGateResult:
+    ok: bool
+    source: str
+    degraded: bool
+    matched_event_id: int | None
+    reasons: tuple[str, ...]
+
+
+def validate_qb_gate(
+    state_db: StateDatabase,
+    campaign_unit_key: str,
+    qb_result_path: Path,
+    *,
+    allow_manual: bool = False,
+) -> QbGateResult:
+    """Manual evidence never authorizes publication in the skeleton workflow."""
+    try:
+        unit = state.get_unit(state_db, campaign_unit_key)
+        derive = state.gate_view(state_db, campaign_unit_key).derive
+        if derive is None:
+            raise sandbox._held("state_inconsistent", "missing DERIVE")
+        event, _ = _qb_gate(state_db, unit, qb_result_path, str(derive["derived_commit_sha"]))
+        return QbGateResult(True, "first_party", False, int(str(event["event_id"])), ())
+    except sandbox._Reject as exc:
+        return QbGateResult(False, "first_party", False, None, (exc.code, exc.detail))
+
+
+def _trace(root: Path, stage: str, **facts: object) -> None:
+    root.mkdir(parents=True, exist_ok=True)
+    with (root / "review-trace.jsonl").open("a", encoding="utf-8") as stream:
+        stream.write(json.dumps(dict(stage=stage, **facts), ensure_ascii=False, sort_keys=True) + "\n")
+
+
+def pending_message(request_id: str) -> str:
+    return (
+        f"该 unit 最新的验证请求(request_id={request_id})还没有结果。"
+        "若 qb-result-fetch 曾报告结果无法识别(QB_RESULT_UNRECOGNIZED,例如各架构状态非空或快照漂移;"
+        "可在运行 qb-result-fetch 时所用的 state_root 下查看该 request 的 trace 确认),"
+        "重读不会改变结果,请按其输出的指引处置,或用 campaign-release-worktrees --abandon "
+        "放弃该 unit;否则稍后重跑 qb-result-fetch。"
+    )
+
+
+def _request(db: StateDatabase, key: str) -> dict[str, Any] | None:
+    conn = state._read_connection(db)
+    try:
+        row = conn.execute(
+            "SELECT * FROM campaign_qb_requests WHERE campaign_unit_key=? "
+            "ORDER BY request_seq DESC LIMIT 1",
+            (key,),
+        ).fetchone()
+        return dict(row) if row else None
+    finally:
+        conn.close()
+
+
+def _qb_gate(
+    db: StateDatabase,
+    unit: state.Unit,
+    path: Path,
+    derived: str,
+) -> tuple[Mapping[str, object], dict[str, Any]]:
+    request = _request(db, unit.campaign_unit_key)
+    if request is None:
+        raise sandbox._Reject("REJECTED_QB_NOT_VERIFIED", "no verification request")
+    event = state.latest_qb_result(db, unit.campaign_unit_key)
+    if event is None:
+        raise sandbox._Reject("REJECTED_QB_REQUEST_PENDING", pending_message(request["request_id"]))
+    try:
+        raw = path.read_bytes()
+        digest = hashlib.sha256(raw).hexdigest()
+        if digest != event["qb_result_sha256"]:
+            conn = state._read_connection(db)
+            try:
+                old = conn.execute(
+                    "SELECT 1 FROM campaign_qb_events e JOIN campaign_qb_requests r "
+                    "ON r.request_seq=e.request_seq WHERE r.campaign_unit_key=? "
+                    "AND e.event_type='RESULT' AND e.qb_result_sha256=? AND e.event_id<>?",
+                    (unit.campaign_unit_key, digest, event["event_id"]),
+                ).fetchone()
+            finally:
+                conn.close()
+            if old:
+                raise sandbox._Reject("REJECTED_QB_SUPERSEDED", "result is superseded")
+            raise ValueError("result bytes changed")
+        result = json.loads(raw)
+        if not isinstance(result, dict) or set(result) != RESULT_KEYS:
+            raise ValueError("result is not an object")
+        if (
+            not isinstance(result["params_echo"], dict)
+            or set(result["params_echo"])
+            != {
+                "BUILD_TYPE",
+                "BUILD_REFERENCE",
+                "SNAPSHOT_NUM",
+                "PROJECT_BRANCH",
+                "FAIL_FAST",
+            }
+            or not isinstance(result["child_params_echo"], dict)
+            or set(result["child_params_echo"]) != {"BUILD_REFERENCE", "SNAPSHOT_NUM_URL"}
+            or type(result["snapshot_drift_accepted"]) is not bool
+            or type(result["accepted"]) not in {bool, type(None)}
+            or result["accepted"] != event["accepted"]
+        ):
+            raise ValueError("invalid result shape")
+        target = f"{unit.project}@{derived}"
+        if request["sbs_target"] != target or event["sbs_target_echo"] != target:
+            raise ValueError("target does not bind derived commit")
+        for field in ("qb_build_id", "status", "sbs_target_echo"):
+            if result.get(field) != event[field]:
+                raise ValueError("result and event differ")
+        if (
+            result.get("request_marker_echo")
+            != "clang-fix-campaign request=" + request["request_id"]
+        ):
+            raise ValueError("request marker differs")
+        profile = state.qb_profile(db, unit.branch)
+        if profile is None:
+            raise sandbox._held("state_inconsistent", "missing frozen QuickBuild profile")
+        text = profile["profile_json"]
+        if hashlib.sha256(text.encode()).hexdigest() != profile["profile_sha256"]:
+            raise sandbox._held("state_inconsistent", "frozen profile hash differs")
+        require_accept = json.loads(text)["qb_pass_requires_accept"]
+        if type(require_accept) is not bool:
+            raise ValueError("invalid acceptance policy")
+        per_arch = (
+            json.loads(str(event["per_arch_status_json"]))
+            if event["per_arch_status_json"] is not None
+            else None
+        )
+        if result.get("per_arch_status") != per_arch:
+            raise ValueError("architecture status differs")
+    except (OSError, ValueError, KeyError, TypeError) as exc:
+        raise sandbox._Reject("REJECTED_QB_BINDING_MISMATCH", type(exc).__name__) from exc
+    if (
+        event["status"] != "PASS"
+        or require_accept
+        and event["accepted"] != 1
+        or per_arch is not None
+        and (
+            not isinstance(per_arch, dict)
+            or set(per_arch) != state.ARCH_NORMS
+            or any(value != "PASS" for value in per_arch.values())
+        )
+    ):
+        raise sandbox._Reject("REJECTED_QB_NOT_VERIFIED", "QuickBuild pass gate failed")
+    return event, result
+
+
+def run(options: ReviewOptions) -> sandbox.SandboxSubmitOutcome:
+    db = StateDatabase(options.state_db)
+    payload: dict[str, Any] = dict(
+        action=None,
+        status=None,
+        error_code=None,
+        message=None,
+        review_url=None,
+        qb_event_id=None,
+        change_id=None,
+        derived_commit_sha=None,
+        snapshot_drift_accepted=None,
+        snapshot_used=None,
+    )
+    unit = None
+    aggregate = None
+    locks = ExitStack()
+    trace_root = None
+    try:
+        config = sandbox._config(options.config)
+        ids = tuple(item.strip() for item in options.verification_ids.split(","))
+        if len(ids) != 3 or len(set(ids)) != 3 or not all(ids):
+            raise sandbox._Reject(
+                "INVALID_ARGS", "three distinct verification ids required", exit_code=2
+            )
+        conn = state._read_connection(db)
+        try:
+            lock_key = str(sandbox._links(conn, ids)[0]["campaign_unit_key"])
+        finally:
+            conn.close()
+        locks.enter_context(sandbox._locks(config.workspace / _unit_hash(lock_key)))
+        trace_root = config.workspace / _unit_hash(lock_key)
+        _trace(trace_root, "locked")
+        if is_abandoned(db, lock_key):
+            raise sandbox._Reject("REJECTED_UNIT_ABANDONED", "unit abandoned")
+        conn = state._read_connection(db)
+        try:
+            conn.execute("BEGIN")
+            links = sandbox._links(conn, ids)
+            if str(links[0]["campaign_unit_key"]) != lock_key:
+                raise sandbox._held("state_inconsistent", "unit changed during locking")
+            unit = state._require_unit(conn, lock_key)
+            round_ = sandbox._round(conn, lock_key)
+            if round_ is None or links[0]["round_index"] != round_.round_index:
+                raise sandbox._Reject("REJECTED_ROUND_SUPERSEDED", "not the final round")
+            status = sandbox._status(conn, lock_key)
+        finally:
+            conn.close()
+        if options.review_target != "refs/for/" + unit.branch:
+            raise sandbox._Reject("REJECTED_REVIEW_TARGET_MISMATCH", "review branch differs")
+        if sandbox.check_push_ref(options.review_target) != sandbox.RefClass.REVIEW:
+            raise sandbox._Reject("REJECTED_REF_NOT_ALLOWED", "not a review ref")
+        aggregate = aggregate_verifications(ids, db)
+        if not aggregate.ok or any(
+            getattr(aggregate, field) != getattr(unit, field)
+            for field in ("base_commit", "project", "branch", "spec_name")
+        ):
+            raise sandbox._held("aggregate_mismatch", "; ".join(aggregate.reasons))
+        _trace(trace_root, "aggregate_verified")
+        view = state.gate_view(db, lock_key)
+        stored = view.derive
+        if stored is None:
+            raise sandbox._held("state_inconsistent", "missing DERIVE")
+        derived = str(stored["derived_commit_sha"])
+        qb, result = _qb_gate(db, unit, options.qb_result, derived)
+        _trace(trace_root, "qb_verified", event_id=qb["event_id"])
+        payload.update(
+            qb_event_id=qb["event_id"],
+            snapshot_used=result.get("snapshot_used"),
+            snapshot_drift_accepted=result.get("snapshot_drift_accepted"),
+        )
+        edit = sandbox._bound_bytes(
+            round_,
+            (
+                round_.edit_spec_sha256,
+                str(aggregate.edit_spec_sha256),
+                *(r.edit_spec_sha256 for r in aggregate.records),
+            ),
+        )
+        _trace(trace_root, "edit_spec_verified")
+        policy = state.latest_policy_for_round(db, lock_key, round_.round_index)
+        if policy is None or policy.get("edit_source_kind") not in {"generated", "suppress"}:
+            raise sandbox._held("state_inconsistent", "missing or unsupported policy source")
+        src = config.workspace / _unit_hash(lock_key) / "src"
+        sandbox._source(config.git, src, unit)
+        try:
+            verdict = evaluate(edit, src, cast(SourceKind, policy["edit_source_kind"]))
+        except PolicyInputError as exc:
+            raise sandbox._held("edit_spec_rebind_mismatch", str(exc)) from exc
+        if (verdict.verdict, verdict.fix_strategy_final) != (
+            policy["verdict"],
+            policy["fix_strategy_final"],
+        ):
+            raise sandbox._held("state_inconsistent", "stored and recomputed policy differ")
+        if verdict.verdict == "forbidden":
+            raise sandbox._held("suppress_policy_recheck", "forbidden suppression")
+        _trace(trace_root, "policy_verified", fix_strategy_final=verdict.fix_strategy_final)
+        if verdict.fix_strategy_final != "code" or not view.reproduced:
+            state.append_status(db, lock_key, "REVIEW_INELIGIBLE", "review_gate")
+            raise sandbox._Reject("REJECTED_REVIEW_GATE", "A2 quality gate failed")
+        if status not in {
+            "SANDBOX_QB_PASS",
+            "REVIEW_PUSHING",
+            "REVIEW_PUSH_FAILED",
+            "REVIEW_PUSHED",
+        }:
+            raise sandbox._held("state_inconsistent", "review state is not eligible")
+        _trace(trace_root, "quality_gate_verified")
+        submission_key = compute_submission_key(
+            unit.submission_identity_key, str(aggregate.verified_tree_sha)
+        )
+        change_id = state.lookup_change_id(db, submission_key)
+        if change_id is None:
+            raise sandbox._held("state_inconsistent", "missing cached Change-Id")
+        main = Path(next(r.worktree_path for r in aggregate.records if r.arch == unit.primary_arch))
+        inputs = sandbox.DeriveInputs(
+            main,
+            str(aggregate.verified_tree_sha),
+            str(aggregate.base_commit),
+            f"{sandbox.SUBJECT_PREFIX}{stored['message_brief']}\n\nChange-Id: {change_id}\n",
+            *(
+                str(stored[k])
+                for k in ("author_identity", "committer_identity", "author_date", "committer_date")
+            ),
+        )
+        snapshot = sandbox.SubmitSnapshot(
+            unit,
+            round_,
+            links,
+            str(status),
+            aggregate,
+            policy,
+            stored,
+            change_id,
+            submission_key,
+            inputs,
+            derived,
+            config.remote_base.rstrip("/") + "/" + unit.project,
+            config.git,
+            edit,
+        )
+        checked = sandbox.toctou_recheck(db, snapshot, src_clean=src)
+        if not checked.ok:
+            raise sandbox._Reject(
+                str(checked.error_code),
+                str(checked.detail),
+                held=checked.held_reason,
+                arch=checked.held_arch,
+            )
+        again, _ = _qb_gate(db, unit, options.qb_result, derived)
+        if again != qb:
+            raise sandbox._Reject("REJECTED_QB_SUPERSEDED", "result changed during review")
+        _trace(trace_root, "toctou_verified")
+        payload.update(change_id=change_id, derived_commit_sha=derived)
+        _push(
+            db,
+            snapshot,
+            options.review_target,
+            int(str(qb["event_id"])),
+            payload,
+            config.workspace / _unit_hash(lock_key),
+        )
+        return sandbox.SandboxSubmitOutcome(0, payload)
+    except sandbox._Reject as exc:
+        if trace_root is not None:
+            _trace(trace_root, "rejected", error_code=exc.code)
+        payload.update(action="rejected", error_code=exc.code, message=exc.detail)
+        if exc.held and unit:
+            arch = exc.arch
+            if arch is None and exc.held in state._ARCH_SCOPED_HELD_REASONS:
+                arch = state.ARCH_RAW_TO_NORM[unit.primary_arch or ""]
+            state.append_status(
+                db, unit.campaign_unit_key, state.HELD_FOR_INVESTIGATION, exc.held, arch
+            )
+        elif exc.code == "REJECTED_WORKTREE_MISSING" and unit and aggregate:
+            state.append_status(db, unit.campaign_unit_key, "WORKTREE_LOST", exc.detail)
+        if unit:
+            payload["status"] = state.latest_status(db, unit.campaign_unit_key)
+        return sandbox.SandboxSubmitOutcome(exc.exit_code, payload)
+    finally:
+        locks.close()
+
+
+def _push(
+    db: StateDatabase,
+    snapshot: sandbox.SubmitSnapshot,
+    ref: str,
+    qb_event_id: int,
+    payload: dict[str, Any],
+    root: Path,
+) -> None:
+    key = snapshot.unit.campaign_unit_key
+    existing = state.gate_view(db, key)
+    if (
+        existing.review_push
+        and all(
+            existing.review_push.get(k) == v
+            for k, v in (
+                ("ref", ref),
+                ("pushed_sha", snapshot.derived),
+                ("result", "ok"),
+            )
+        )
+        and existing.review
+        and existing.review.get("outcome") == "pushed"
+    ):
+        payload.update(
+            action="already_pushed",
+            status="REVIEW_PUSHED",
+            review_url=existing.review.get("review_url"),
+        )
+        if state.latest_status(db, key) != "REVIEW_PUSHED":
+            state.append_status(db, key, "REVIEW_PUSHED")
+        _trace(root, "already_pushed")
+        return
+    state.append_status(db, key, "REVIEW_PUSHING")
+    try:
+        with sandbox._transport(snapshot, root) as transport:
+            with sandbox._transport_errors():
+                snapshot.git.run(
+                    None, "cat-file", "-e", snapshot.derived + "^{commit}", git_dir=transport
+                )
+                completed = snapshot.git.run(
+                    None,
+                    "push",
+                    "--porcelain",
+                    "--no-verify",
+                    "--no-follow-tags",
+                    "--recurse-submodules=no",
+                    snapshot.remote,
+                    f"{snapshot.derived}:{ref}",
+                    remote=True,
+                    git_dir=transport,
+                )
+    except sandbox._TransportFailure as exc:
+        _trace(root, "push_failed", error_code="PUSH_FAILED")
+        state.append_status(db, key, "REVIEW_PUSH_FAILED")
+        raise sandbox._Reject("PUSH_FAILED", type(exc).__name__, exit_code=5) from exc
+    urls = re.findall(r"https?://[^\s<>]+", completed.stdout + "\n" + completed.stderr)
+    url = urls[0] if urls else None
+    _trace(root, "push_completed", review_url_found=bool(url),
+           reason=None if url else "no_change_url_in_push_output")
+    now = datetime.now(timezone.utc).isoformat()
+    state.append_event(
+        db,
+        key,
+        "PUSH",
+        dict(
+            ref=ref, ref_class="review", pushed_sha=snapshot.derived, result="ok", url=url, at=now
+        ),
+    )
+    state.append_event(
+        db,
+        key,
+        "REVIEW",
+        dict(outcome="pushed", review_url=url, degraded=False, qb_event_id=qb_event_id, at=now),
+    )
+    state.append_status(db, key, "REVIEW_PUSHED")
+    payload.update(action="pushed", status="REVIEW_PUSHED", review_url=url)
+
+
+def main(argv: list[str], *, stdout: TextIO) -> int:
+    try:
+        parser = JsonParser(prog="review-submit")
+        for name in ("verification-ids", "review-target"):
+            parser.add_argument("--" + name, required=True)
+        for name in ("state-db", "config", "qb-result"):
+            parser.add_argument("--" + name, type=Path, required=True)
+        args = parser.parse_args(argv)
+        result = run(ReviewOptions(**vars(args)))
+    except ValueError as exc:
+        result = sandbox.SandboxSubmitOutcome(2, dict(error_code="INVALID_ARGS", message=str(exc)))
+    except state.CampaignStateBusy:
+        result = sandbox.SandboxSubmitOutcome(4, dict(error_code="CAMPAIGN_STATE_BUSY"))
+    except (state.CampaignStateError, OSError, subprocess.SubprocessError) as exc:
+        result = sandbox.SandboxSubmitOutcome(
+            5, dict(error_code="INTERNAL_ERROR", message=type(exc).__name__)
+        )
+    print(json.dumps(dict(result.payload), ensure_ascii=False, sort_keys=True), file=stdout)
+    return result.exit_code
