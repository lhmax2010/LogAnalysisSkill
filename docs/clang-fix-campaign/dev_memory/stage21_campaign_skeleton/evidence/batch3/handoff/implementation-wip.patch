+def test_offline_stalled_finish_report(flow):
+    c = flow
+    outcome = campaign_repair_step(c.repair)
+    assert outcome.exit_code == 4, outcome.result.to_dict()
+    assert state.latest_status(c.db, c.key) == "STALLED"
+    assert report.finish(c.db, c.key)[0] == 0
+    assert report.report(c.db)[0]["status"] == "STALLED"
+    print("STATE_SEQUENCE=" + json.dumps(c.sequence + ["STALLED"]))
+
