+def test_offline_abandon_triggered_then_late_pass(flow, monkeypatch):
+    c = flow
+    build_and_push(c, monkeypatch)
+    request(c)
+    assert report.finish(c.db, c.key)[0] == 4
+    report.release(c.db, c.key, c.settings, "Offline Operator", True)
+    assert report.report(c.db)[0]["workspace_status"] == "已放弃"
+    event = read_result(c)
+    outcome = review.run(review.ReviewOptions(c.ids, c.db.path, c.args.config,
+                                             c.state_root / event["qb_result_ref"], "refs/for/tizen_base"))
+    assert outcome.exit_code == 4 and outcome.payload["error_code"] == "REJECTED_UNIT_ABANDONED"
+    assert state.latest_status(c.db, c.key) == "SANDBOX_QB_PASS"
+    assert report.report(c.db)[0]["workspace_status"] == "已放弃"
+    conn = state._read_connection(c.db)
+    try:
+        assert conn.execute("SELECT count(*) FROM campaign_gate_events WHERE event_type='REVIEW'").fetchone()[0] == 0
+    finally:
+        conn.close()
+    print("STATE_SEQUENCE=" + json.dumps(c.sequence))
